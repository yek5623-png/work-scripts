function installDailyLiveLinks(workbook: ExcelScript.Workbook) {
const daily=workbook.getWorksheet("데일리");const config=workbook.getWorksheet("데일리연결");
if(!daily||!config||!workbook.getNamedItem("연결_현재_01"))throw new Error("온라인 자동연결용 파일과 데일리 탭을 먼저 준비하세요.");
const specs: {address:string;row:number;col:number;rows:number;cols:number;name:string}[]=[{"address":"J4:J5","row":3,"col":9,"rows":2,"cols":1,"name":"연결_현재_01"},{"address":"B6:C50","row":5,"col":1,"rows":45,"cols":2,"name":"연결_현재_02"},{"address":"E6:G50","row":5,"col":4,"rows":45,"cols":3,"name":"연결_현재_03"},{"address":"I6:J50","row":5,"col":8,"rows":45,"cols":2,"name":"연결_현재_04"},{"address":"L6:M50","row":5,"col":11,"rows":45,"cols":2,"name":"연결_현재_05"},{"address":"R6:R50","row":5,"col":17,"rows":45,"cols":1,"name":"연결_현재_06"},{"address":"AY6:AY29","row":5,"col":50,"rows":24,"cols":1,"name":"연결_현재_07"},{"address":"BC6:BC29","row":5,"col":54,"rows":24,"cols":1,"name":"연결_현재_08"},{"address":"BP6:CD29","row":5,"col":67,"rows":24,"cols":15,"name":"연결_현재_09"}];
for(const spec of specs){
const rows:string[][]=[];for(let row=1;row<=spec.rows;row++){const line:string[]=[];for(let col=1;col<=spec.cols;col++){const ref='INDEX('+spec.name+','+row+','+col+')';line.push('=IF(ISBLANK('+ref+'),"",'+ref+')');}rows.push(line);}
// 기존 양식의 병합을 유지합니다. 병합 첫 칸만 기록하고 나머지 칸은 건너뜁니다.
const target=daily.getRange(spec.address);const skip:Set<string>=new Set<string>();const merged=target.getMergedAreas();
if(merged){const addresses=merged.getAddress().split(',');for(const address of addresses){const area=daily.getRange(address.slice(address.lastIndexOf('!')+1));const beginRow=area.getRowIndex();const beginCol=area.getColumnIndex();for(let rr=0;rr<area.getRowCount();rr++)for(let cc=0;cc<area.getColumnCount();cc++)if(rr!==0||cc!==0)skip.add((beginRow+rr)+','+(beginCol+cc));}}
if(skip.size===0){target.setFormulas(rows);}else{for(let rr=0;rr<spec.rows;rr++)for(let cc=0;cc<spec.cols;cc++)if(!skip.has((spec.row+rr)+','+(spec.col+cc)))daily.getCell(spec.row+rr,spec.col+cc).setFormula(rows[rr][cc]);}
}
