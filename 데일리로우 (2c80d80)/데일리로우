type CellValue = string | number | boolean;


interface PersonBlock {
  name: string;
  column: number;
}


interface TransferPlan {
  person: PersonBlock;
  current: CellValue[][];
  added: CellValue[][];
  startRow: number;
}


function main(
  workbook: ExcelScript.Workbook,
  작업: "연결준비" | "적재" = "연결준비",
  팀장: string = "김유진",
  최신자료확인: boolean = false
): string {
  const BASE_URL =
    "https://coupartnersnam.sharepoint.com/sites/tcksm/" +
    "Shared Documents/긴급조치🦄/";


  const TEAMS = [
    "김유진",
    "홍예은",
    "김보형",
    "이병정",
    "남문옥",
    "배효진",
    "류가람"
  ];


  // 원본 B5:E1004, 사람당 최대 1,000행.
  // 원본의 끝을 외부 참조로 직접 조회할 수 없어 범위를 지정합니다.
  const MAX_ROWS = 1000;
  const SOURCE_FIRST_ROW = 5;
  const DEST_FIRST_ROW_INDEX = 3; // 엑셀 4행
  const HELPER_FIRST_ROW_INDEX = 3;


  const MARKER = "TEAM_RAW_TRANSFER_V1";
  const results: string[] = [];


  const selected = 팀장.trim();
  if (selected !== "전체" && TEAMS.indexOf(selected) < 0) {
    throw new Error(
      "팀장은 전체 또는 다음 이름으로 입력하세요: " + TEAMS.join(", ")
    );
  }


  if (작업 === "적재" && !최신자료확인) {
    throw new Error(
      "외부 연결을 새로 고침하고 _연결_팀장 탭의 최신 자료를 " +
      "확인한 뒤 최신자료확인=true로 실행하세요."
    );
  }


  for (let teamIndex = 0; teamIndex < TEAMS.length; teamIndex++) {
    const team = TEAMS[teamIndex];
    if (selected !== "전체" && selected !== team) continue;


    const target = workbook.getWorksheet(team);
    if (!target) {
      results.push(`[${team}] 중단: B파일에 팀장 탭이 없습니다.`);
      continue;
    }


    try {
      const people = readPeople(target);
      if (people.length === 0) {
        results.push(`[${team}] 중단: 2행에 이름이 없습니다.`);
        continue;
      }


      const fileName = `${teamIndex + 1}. ${team} 팀장.xlsx`;
      const connectionName = `_연결_${team}`;
      const historyName = `_기록_${team}`;


      if (작업 === "연결준비") {
        const connection = getOwnedSheet(
          workbook, connectionName, MARKER
        );


        // 연결 탭만 다시 작성합니다. 적재 이력은 유지합니다.
        const used = connection.getUsedRange();
        if (used) clearContentsInBatches(connection, used);


        connection.getRange("A1").setValue(MARKER);
        connection.getRange("A2").setValue(
          `${fileName} / 원본 5행부터 ${MAX_ROWS}행 연결`
        );


        for (const person of people) {
          connection.getCell(2, person.column).setValue(person.name);


          const referencePrefix =
            "'" +
            (BASE_URL + "[" + fileName + "]" + person.name)
              .replace(/'/g, "''") +
            "'!";


          // 마지막 확인행을 하나 더 연결합니다.
          // 범위 끝에 자료가 있으면 적재를 중단합니다.
          const formulas: string[][] = [];


          for (let r = 0; r <= MAX_ROWS; r++) {
            const sourceRow = SOURCE_FIRST_ROW + r;
            const row: string[] = [];


            for (let c = 0; c < 4; c++) {
              const sourceColumn = ["B", "C", "D", "E"][c];
              const ref = referencePrefix + sourceColumn + sourceRow;


              // 진짜 빈칸은 "", 실제 숫자 0은 0으로 유지.
              // 연결 오류는 숨기지 않습니다.
              row.push(`=IF(${ref}="","",${ref})`);
            }


            formulas.push(row);
          }


          // 외부 참조 수식은 문자열이 길어 요청 크기를 기준으로 나눕니다.
          setFormulasInBatches(
            connection, HELPER_FIRST_ROW_INDEX, person.column, formulas
          );
        }


        results.push(
          `[${team}] 연결 준비 완료: ${people.length}명. ` +
          `${connectionName} 탭에서 갱신 결과를 확인하세요.`
        );
        continue;
      }


      const connection = workbook.getWorksheet(connectionName);
      if (
        !connection ||
        connection.getRange("A1").getValue() !== MARKER
      ) {
        throw new Error("먼저 연결준비를 실행하세요.");
      }


      if (target.getProtection().getProtected()) {
        throw new Error("적재 대상 탭의 보호를 해제한 후 실행하세요.");
      }


      const history = getOwnedSheet(workbook, historyName, MARKER);
      const plans: TransferPlan[] = [];


      // 해당 팀의 전체 자료를 검사한 뒤 적재를 시작합니다.
      for (const person of people) {
        const linkedName = String(
          connection.getCell(2, person.column).getValue()
        );


        if (linkedName !== person.name) {
          throw new Error(
            `${person.name}: 2행 배치가 변경됐습니다. 연결준비를 다시 실행하세요.`
          );
        }


        const sourceRange = connection.getRangeByIndexes(
          HELPER_FIRST_ROW_INDEX,
          person.column,
          MAX_ROWS + 1,
          4
        );


        const types = sourceRange.getValueTypes();
        for (let r = 0; r < types.length; r++) {
          for (let c = 0; c < 4; c++) {
            if (types[r][c] === ExcelScript.RangeValueType.error) {
              throw new Error(
                `${person.name}: 원본 ${SOURCE_FIRST_ROW + r}행에 ` +
                "연결 또는 셀 오류가 있습니다. 원본은 지우지 마세요."
              );
            }
          }
        }


        const raw = sourceRange.getValues();


        if (
          hasData(raw[MAX_ROWS - 1]) ||
          hasData(raw[MAX_ROWS])
        ) {
          throw new Error(
            `${person.name}: 조회 범위 끝에 자료가 있습니다. ` +
            "MAX_ROWS를 늘리고 연결준비부터 다시 실행하세요."
          );
        }


        const current = raw
          .slice(0, MAX_ROWS)
          .filter(row => hasData(row));


        const savedName = String(
          history.getCell(2, person.column).getValue()
        );


        if (savedName !== "" && savedName !== person.name) {
          throw new Error(
            `${person.name}: 기존 적재 이력과 열 배치가 다릅니다. ` +
            "이름별 열 위치 변경 내용을 먼저 확인해야 합니다."
          );
        }


        const previous = history.getRangeByIndexes(
          HELPER_FIRST_ROW_INDEX,
          person.column,
          MAX_ROWS,
          4
        ).getValues().filter(row => hasData(row));


        // 원본 삭제 후, 갱신된 빈 상태로 실행하면 이력이 초기화됩니다.
        if (current.length === 0) {
          plans.push({
            person,
            current,
            added: [],
            startRow: DEST_FIRST_ROW_INDEX
          });
          continue;
        }


        // 이전에 옮긴 자료가 원본 앞부분에 그대로 있으면
        // 그 뒤에 새로 추가된 자료만 적재합니다.
        if (previous.length > 0 && !isPrefix(previous, current)) {
          throw new Error(
            `${person.name}: 원본이 이전 적재 이후 수정·삭제됐습니다. ` +
            "중복 방지를 위해 중단했습니다. 원본 삭제 후 빈 상태를 " +
            "갱신하여 적재를 한 번 실행해야 새 묶음을 받을 수 있습니다."
          );
        }


        const added = current.slice(previous.length);
        const startRow = findAppendRow(
          target,
          person.column,
          DEST_FIRST_ROW_INDEX
        );


        if (startRow + added.length > 1048576) {
          throw new Error(`${person.name}: 시트 최대 행 수를 초과합니다.`);
        }


        plans.push({ person, current, added, startRow });
      }


      let total = 0;
      let emptyCount = 0;


      for (const plan of plans) {
        const column = plan.person.column;


        if (plan.added.length > 0) {
          target.getRangeByIndexes(
            plan.startRow,
            column,
            plan.added.length,
            4
          ).setValues(asLiteralValues(plan.added));


          total += plan.added.length;
        }


        history.getCell(2, column).setValue(plan.person.name);


        if (plan.current.length === 0) {
          history.getRangeByIndexes(
            HELPER_FIRST_ROW_INDEX, column, MAX_ROWS, 4
          ).clear(ExcelScript.ClearApplyTo.contents);
          emptyCount++;
        } else {
          history.getRangeByIndexes(
            HELPER_FIRST_ROW_INDEX,
            column,
            plan.current.length,
            4
          ).setValues(asLiteralValues(plan.current));
        }
      }


      results.push(
        `[${team}] 적재 완료: ${total}행 / ` +
        `원본 공란 확인: ${emptyCount}명`
      );
    } catch (error) {
      results.push(
        `[${team}] 중단: ${String(error)} ` +
        "실행 중 오류라면 일부 적재 여부를 확인하고 원본을 보존하세요."
      );
    }
  }


  if (작업 === "연결준비") {
    try {
      workbook.refreshAllLinksToLinkedWorkbooks();
      results.push(
        "외부 연결 갱신을 요청했습니다. 완료 여부는 연결 탭에서 확인하세요."
      );
    } catch (error) {
      results.push(
        "자동 갱신 요청 실패: 데이터 → 통합 문서 연결에서 " +
        "수동으로 갱신하세요. " + String(error)
      );
    }
  }


  const message = results.join("\n");
  console.log(message);
  return message;
}


function readPeople(sheet: ExcelScript.Worksheet): PersonBlock[] {
  const used = sheet.getRange("2:2").getUsedRange(true);
  if (!used) return [];


  const texts = used.getTexts()[0];
  const firstColumn = used.getColumnIndex();
  const people: PersonBlock[] = [];


  for (let i = 0; i < texts.length; i++) {
    const name = texts[i].trim();
    if (name === "") continue;


    const column = firstColumn + i;


    if (column + 4 > 16384) {
      throw new Error(`${name}: 4개 열을 배치할 공간이 없습니다.`);
    }


    for (const previous of people) {
      if (previous.name === name) {
        throw new Error(`2행에 ${name} 이름이 중복되어 있습니다.`);
      }
      if (column < previous.column + 4) {
        throw new Error(
          `${previous.name} / ${name}: 4개 열 구역이 겹칩니다. ` +
          "2행에는 각 구역의 첫 셀에만 이름이 있어야 합니다."
        );
      }
    }


    people.push({ name, column });
  }


  return people;
}


function getOwnedSheet(
  workbook: ExcelScript.Workbook,
  name: string,
  marker: string
): ExcelScript.Worksheet {
  let sheet = workbook.getWorksheet(name);


  if (!sheet) {
    sheet = workbook.addWorksheet(name);
    sheet.getRange("A1").setValue(marker);
    return sheet;
  }


  if (sheet.getRange("A1").getValue() !== marker) {
    throw new Error(
      `${name} 이름의 기존 탭이 있습니다. 다른 이름으로 변경해주세요.`
    );
  }


  return sheet;
}


function hasData(row: CellValue[]): boolean {
  return row.some(value => value !== "");
}


function isPrefix(
  previous: CellValue[][],
  current: CellValue[][]
): boolean {
  if (previous.length > current.length) return false;


  for (let r = 0; r < previous.length; r++) {
    for (let c = 0; c < 4; c++) {
      if (previous[r][c] !== current[r][c]) return false;
    }
  }


  return true;
}


function findAppendRow(
  sheet: ExcelScript.Worksheet,
  column: number,
  minimumRow: number
): number {
  const block = sheet.getRangeByIndexes(
    minimumRow,
    column,
    1048576 - minimumRow,
    4
  );


  // 값뿐 아니라 기존 수식도 보존하기 위해 false 사용.
  const used = block.getUsedRange(false);
  if (!used) return minimumRow;


  // 서식만 남은 행은 제외하고 값 또는 수식의 마지막 행을 검색.
  const formulas = used.getFormulas();


  for (let r = formulas.length - 1; r >= 0; r--) {
    if (formulas[r].some(value => value !== "")) {
      return used.getRowIndex() + r + 1;
    }
  }


  return minimumRow;
}


function asLiteralValues(values: CellValue[][]): CellValue[][] {
  return values.map(row =>
    row.map(value => {
      // =, +, -로 시작하는 문자열을 수식으로 실행하지 않고 저장.
      if (
        typeof value === "string" &&
        /^[=+\-']/.test(value)
      ) {
        return "'" + value;
      }
      return value;
    })
  );
}

// 큰 사용 범위를 한 번에 clear하면 RequestPayloadSizeLimitExceeded가 발생할 수 있습니다.
// 행과 열을 함께 나누어 한 번에 최대 1,000개 셀만 처리합니다.
function clearContentsInBatches(
  sheet: ExcelScript.Worksheet,
  range: ExcelScript.Range
): void {
  const firstRow = range.getRowIndex();
  const firstColumn = range.getColumnIndex();
  const rowCount = range.getRowCount();
  const columnCount = range.getColumnCount();

  for (let c = 0; c < columnCount; c += 4) {
    const width = Math.min(4, columnCount - c);
    for (let r = 0; r < rowCount; r += 250) {
      const part = sheet.getRangeByIndexes(
        firstRow + r, firstColumn + c,
        Math.min(250, rowCount - r), width
      );
      part.clear(ExcelScript.ClearApplyTo.contents);
      // 읽기로 앞선 삭제를 반영하여 다음 묶음과 요청이 누적되지 않게 합니다.
      part.getCell(0, 0).getValue();
    }
  }
}

function setFormulasInBatches(
  sheet: ExcelScript.Worksheet,
  firstRow: number,
  firstColumn: number,
  formulas: string[][]
): void {
  // 100행 단위로 나누어 긴 SharePoint 경로가 반복되는 요청을 줄입니다.
  for (let r = 0; r < formulas.length; r += 100) {
    const batch = formulas.slice(r, r + 100);
    const part = sheet.getRangeByIndexes(
      firstRow + r, firstColumn, batch.length, batch[0].length
    );
    part.setFormulas(batch);
    part.getCell(0, 0).getValue();
  }
}
