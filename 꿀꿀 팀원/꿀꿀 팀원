function main(workbook: ExcelScript.Workbook) {
  const sheet: ExcelScript.Worksheet = workbook.getActiveWorksheet();

  // 원본은 B~K 읽기만 함. 절대 쓰지 않음.
  const SOURCE_START_ROW_INDEX: number = 1; // 2행부터
  const SOURCE_START_COL_INDEX: number = 1; // B
  const SOURCE_COL_COUNT: number = 10; // B:K

  // B:K 안에서의 상대 위치
  // B=0, C=1, D=2, E=3, F=4, G=5, H=6, I=7, J=8, K=9
  const SRC_ID_OFFSET: number = 2; // D 아이디
  const SRC_NAME_OFFSET: number = 3; // E 이름
  const SRC_WORK_TIME_OFFSET: number = 4; // F 근무시간
  const SRC_SHIFT_OFFSET: number = 5; // G 시프트
  const SRC_NUMBER_OFFSET: number = 7; // I 번호
  const SRC_LEADER_OFFSET: number = 8; // J 담당팀장

  // 한 세트 구성: NO / 아이디 / 이름 / 근무시간 / 시프트 / 번호 / 담당팀장
  const SET_COL_COUNT: number = 7;
  const DATA_ROW_COUNT: number = 17;

  const HEADER_VALUES: (string | number | boolean)[] = [
    "NO",
    "아이디",
    "이름",
    "근무시간",
    "시프트",
    "번호",
    "담당팀장"
  ];

  // 세트 시작 위치
  // 1~4세트: M10, U10, AC10, AK10
  // 5~8세트: M30, U30, AC30, AK30
  // 9세트: M50
  const SET_START_ROW_INDEXES: number[] = [9, 29, 49]; // 10행, 30행, 50행
  const SET_START_COL_INDEXES: number[] = [12, 20, 28, 36]; // M, U, AC, AK
  const TOTAL_SET_COUNT: number = 9;

  const usedRange: ExcelScript.Range = sheet.getUsedRange(true);

  if (!usedRange) {
    return;
  }

  const usedStartRowIndex: number = usedRange.getRowIndex();
  const usedRowCount: number = usedRange.getRowCount();
  const lastUsedRowIndex: number = usedStartRowIndex + usedRowCount - 1;

  const sourceRowCount: number = lastUsedRowIndex - SOURCE_START_ROW_INDEX + 1;

  if (sourceRowCount <= 0) {
    return;
  }

  const sourceValues: (string | number | boolean)[][] = sheet
    .getRangeByIndexes(
      SOURCE_START_ROW_INDEX,
      SOURCE_START_COL_INDEX,
      sourceRowCount,
      SOURCE_COL_COUNT
    )
    .getValues();

  const membersByLeader: { [leaderName: string]: MemberInfo[] } = {};
  const usedMemberByLeader: { [leaderName: string]: { [memberKey: string]: boolean } } = {};

  // J열 담당팀장 기준으로 팀원 모으기
  for (let r: number = 0; r < sourceValues.length; r++) {
    const row: (string | number | boolean)[] = sourceValues[r];

    const idValue: string | number | boolean = row[SRC_ID_OFFSET];
    const nameValue: string | number | boolean = row[SRC_NAME_OFFSET];
    const workTimeValue: string | number | boolean = row[SRC_WORK_TIME_OFFSET];
    const shiftValue: string | number | boolean = row[SRC_SHIFT_OFFSET];
    const numberValue: string | number | boolean = row[SRC_NUMBER_OFFSET];
    const leaderValue: string | number | boolean = row[SRC_LEADER_OFFSET];

    const leaderKey: string = normalizeValue(leaderValue);
    const idKey: string = normalizeValue(idValue);
    const nameKey: string = normalizeValue(nameValue);

    if (leaderKey === "") {
      continue;
    }

    if (idKey === "" && nameKey === "") {
      continue;
    }

    // 같은 팀장 안에서 같은 팀원은 한 번만 출력.
    // 아이디가 있으면 아이디 기준, 아이디 없으면 이름 기준.
    const memberKey: string = idKey !== "" ? "ID:" + idKey : "NAME:" + nameKey;

    if (membersByLeader[leaderKey] === undefined) {
      membersByLeader[leaderKey] = [];
    }

    if (usedMemberByLeader[leaderKey] === undefined) {
      usedMemberByLeader[leaderKey] = {};
    }

    if (usedMemberByLeader[leaderKey][memberKey] === true) {
      continue;
    }

    usedMemberByLeader[leaderKey][memberKey] = true;

    membersByLeader[leaderKey].push({
      id: idValue,
      name: nameValue,
      workTime: workTimeValue,
      shift: shiftValue,
      number: numberValue,
      leader: leaderValue
    });
  }

  let setIndex: number = 0;

  for (let blockIndex: number = 0; blockIndex < SET_START_ROW_INDEXES.length; blockIndex++) {
    const setStartRowIndex: number = SET_START_ROW_INDEXES[blockIndex];

    for (let colSetIndex: number = 0; colSetIndex < SET_START_COL_INDEXES.length; colSetIndex++) {
      if (setIndex >= TOTAL_SET_COUNT) {
        return;
      }

      const setStartColIndex: number = SET_START_COL_INDEXES[colSetIndex];

      fillOneSet(
        sheet,
        setStartRowIndex,
        setStartColIndex,
        HEADER_VALUES,
        membersByLeader,
        DATA_ROW_COUNT,
        SET_COL_COUNT
      );

      setIndex++;
    }
  }
}

function fillOneSet(
  sheet: ExcelScript.Worksheet,
  setStartRowIndex: number,
  setStartColIndex: number,
  headerValues: (string | number | boolean)[],
  membersByLeader: { [leaderName: string]: MemberInfo[] },
  dataRowCount: number,
  setColCount: number
) {
  // 세트 첫 칸에 적힌 담당팀장명 읽기.
  // 예: M10, U10, AC10, AK10, M30...
  const leaderCellValue: string | number | boolean = sheet
    .getCell(setStartRowIndex, setStartColIndex)
    .getValue();

  const leaderKey: string = normalizeValue(leaderCellValue);

  // 헤더 고정 입력
  sheet
    .getRangeByIndexes(setStartRowIndex + 1, setStartColIndex, 1, setColCount)
    .setValues([headerValues]);

  const members: MemberInfo[] =
    leaderKey !== "" && membersByLeader[leaderKey] !== undefined
      ? membersByLeader[leaderKey]
      : [];

  const outputValues: (string | number | boolean)[][] = [];

  for (let i: number = 0; i < dataRowCount; i++) {
    if (i < members.length) {
      outputValues.push([
        i + 1,
        members[i].id,
        members[i].name,
        members[i].workTime,
        members[i].shift,
        members[i].number,
        members[i].leader
      ]);
    } else {
      outputValues.push([
        i + 1,
        "",
        "",
        "",
        "",
        "",
        ""
      ]);
    }
  }

  // 실제 적재 영역
  // 예: M12:S28, U12:AA28, AC12:AI28...
  sheet
    .getRangeByIndexes(setStartRowIndex + 2, setStartColIndex, dataRowCount, setColCount)
    .setValues(outputValues);
}

function normalizeValue(value: string | number | boolean): string {
  return String(value).trim();
}

interface MemberInfo {
  id: string | number | boolean;
  name: string | number | boolean;
  workTime: string | number | boolean;
  shift: string | number | boolean;
  number: string | number | boolean;
  leader: string | number | boolean;
}