/**
 * 현재 시트: A1 원문 / D4부터 사번 / F4부터 시프트.
 * F의 끝 근무시간이 8H면 H에 16시간, 그 외에는 8시간을 자동 입력합니다.
 * 같은 사번이 여러 번 나오면 교육시간을 합산합니다.
 */
function main(workbook: ExcelScript.Workbook): void {
  const sheet = workbook.getActiveWorksheet();
  const raw = String(sheet.getRange("A1").getValue() ?? "");
  if (!raw.trim()) throw new Error("A1에 이번 달 교육시간 원문을 먼저 붙여 넣어 주세요.");
  const totals = parseTrainingSeconds(raw);
  if (Object.keys(totals).length === 0) {
    throw new Error("A1에서 팀번호 뒤의 K 또는 CSSP 사번을 찾지 못했습니다. 원문을 확인해 주세요.");
  }
  const used = sheet.getRange("D:D").getUsedRange(true);
  const lastRow = used ? used.getRowIndex() + used.getRowCount() : 3;
  const count = Math.max(0, lastRow - 3);
  const result: (string | number | boolean)[][] = [];
  if (count > 0) {
    const ids = sheet.getRangeByIndexes(3, 3, count, 1).getTexts();
    const shifts = sheet.getRangeByIndexes(3, 5, count, 1).getTexts();
    for (let i = 0; i < count; i++) {
      const id = ids[i][0].trim().toLowerCase();
      if (!id) { result.push(["", "", ""]); continue; }
      const actual = (totals[id] || 0) / 86400;
      const allowed = trainingAllowance(shifts[i][0]);
      result.push([allowed, actual, allowed - actual]);
    }
  }
  sheet.getRange("H3:J3").setValues([["교육가능시간", "실제교육시간", "남은교육시간"]]);
  if (count === 0) return;
  sheet.getRangeByIndexes(3, 7, count, 3).setValues(result);
  sheet.getRangeByIndexes(3, 7, count, 3).setNumberFormatLocal("[h]:mm:ss");
  // J는 수식으로 기록하여 H를 바꾸면 남은시간도 즉시 갱신됩니다.
  // 음수 시간은 Excel에서 ####로 표시되므로 초과분은 -시간:분:초 텍스트로 표시합니다.
  const formulas: string[][] = [];
  for (let i = 0; i < count; i++) {
    const r = i + 4;
    formulas.push([`=IF(OR(D${r}="",H${r}=""),"",IF(H${r}-I${r}<0,"-"&TEXT(ABS(H${r}-I${r}),"[h]:mm:ss"),H${r}-I${r}))`]);
  }
  sheet.getRangeByIndexes(3, 9, count, 1).setFormulas(formulas);
}


function parseTrainingSeconds(raw: string): { [id: string]: number } {
  const totals: { [id: string]: number } = {};
  // 원문 순서: 팀/사번 -> 교육시간. 다음 팀이 시작되면 현재 사람의 구간을 끝냅니다.
  const pattern = /TCK\s*\(\s*Eats\s+SM\s*\)\s*_\s*\d+\s+(K\d+|CSSP[-_][A-Za-z0-9_-]+)\b/gi;
  let current = pattern.exec(raw);
  while (current !== null) {
    const start = pattern.lastIndex;
    const next = pattern.exec(raw);
    const section = raw.slice(start, next ? next.index : raw.length);
    const time = /(?:(\d+)\s*시(?:간)?\s*(?:(\d+)\s*분\s*)?(?:(\d+)\s*초)?|(\d+)\s*분\s*(?:(\d+)\s*초)?|(\d+)\s*초)/.exec(section);
    const seconds = time
      ? Number(time[1] || 0) * 3600 + Number(time[2] || time[4] || 0) * 60 + Number(time[3] || time[5] || time[6] || 0)
      : 0;
    const id = current[1].toLowerCase();
    totals[id] = (totals[id] || 0) + seconds;
    current = next;
  }
  return totals;
}

function trainingAllowance(shift: string): number {
  const match = /(\d+(?:\.\d+)?)\s*H\s*$/i.exec(shift.trim());
  return (match && Number(match[1]) === 8 ? 16 : 8) / 24;
}