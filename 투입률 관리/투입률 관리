function writeFinalComparisonWarnings(sheet: ExcelScript.Worksheet): void {
const comparisonValues = sheet.getRange("F5:I5").getValues()[0]
const dailyCountValue = comparisonValues[0]
const loginCountValue = comparisonValues[1]
const expectedRateValue = comparisonValues[2]
const actualRateValue = comparisonValues[3]

const loginWarning = areComparisonValuesEqual(dailyCountValue, loginCountValue)
    ? ""
    : "로그인 인원수 이상 즉시 확인 필요"
const rateWarning = areComparisonValuesEqual(expectedRateValue, actualRateValue)
    ? ""
    : "투입률 이상 즉시 확인 필요"

sheet.getRange("D6").setValue(loginWarning)
sheet.getRange("G6").setValue(rateWarning)
}

function areComparisonValuesEqual(
left: string | number | boolean,
right: string | number | boolean
): boolean {
if (typeof left === "number" && typeof right === "number") {
    return Math.abs(left - right) < 0.000000001
}

return String(left ?? "").trim() === String(right ?? "").trim()
}

interface ForcedShiftOverride {
name: string
shiftText: string
}

function ensureFixedCoreSheets(workbook: ExcelScript.Workbook): void {
const dailySheet = findWorksheetByName(workbook, "데일리")
const statusSheet = findWorksheetByName(workbook, "상태출력")

if (!dailySheet || !statusSheet) {
    throw new Error("데일리 및 상태출력 탭이 모두 있어야 합니다. 탭 이름은 변경하지 않았습니다.")
}

dailySheet.setPosition(0)
statusSheet.setPosition(1)
}

function getUniqueWorksheetName(workbook: ExcelScript.Workbook, baseName: string): string {
let candidate = baseName
let counter = 1

while (findWorksheetByName(workbook, candidate)) {
    const suffix = `_${counter}`
    const maxBaseLength = 31 - suffix.length
    candidate = `${baseName.slice(0, maxBaseLength)}${suffix}`
    counter++
}

return candidate
}

function applyForcedShiftOverridesToShiftMap(
shiftMap: Record<string, string>,
nameToIdsMap: Record<string, string[]>,
overrides: ForcedShiftOverride[]
): void {
for (const override of overrides) {
const nameKey = normalizeNameKey(override.name)
const ids = nameToIdsMap[nameKey] || nameToIdsMap[override.name] || []
for (const id of ids) {
const idKey = normalizeId(id)
if (idKey !== "") shiftMap[idKey] = override.shiftText
}
}
}

function applyForcedShiftOverridesToShiftMapByAgentRecords(
shiftMap: Record<string, string>,
agentRecords: AgentRecord[],
overrides: ForcedShiftOverride[]
): void {
for (const override of overrides) {
const overrideNameKey = normalizeNameKey(override.name)
for (const record of agentRecords) {
if (normalizeNameKey(record.name) !== overrideNameKey) continue
if (record.idKey !== "") shiftMap[record.idKey] = override.shiftText
}
}
}

function appendForcedShiftScheduledRowsByAgentRecords(
scheduledRows: string[][],
overrides: ForcedShiftOverride[],
agentRecords: AgentRecord[],
targetMinutes: number,
statusById: Record<string, AgentRecord>
): string[][] {
const result = scheduledRows.slice()
const existingIds: Set<string> = new Set<string>()

for (const row of result) {
    existingIds.add(normalizeId(row[0]))
}

for (const override of overrides) {
    const shiftWindow = parseShiftWindow(override.shiftText)
    if (!shiftWindow) continue
    if (!isNowInShift(targetMinutes, shiftWindow)) continue

    const overrideNameKey = normalizeNameKey(override.name)

    for (const record of agentRecords) {
        if (normalizeNameKey(record.name) !== overrideNameKey) continue
        const idKey = normalizeId(record.id)
        if (idKey === "" || existingIds.has(idKey)) continue

        result.push(makeWorkOutputRow(record.id, override.name, statusById))
        existingIds.add(idKey)
    }
}

return result
}

function buildForcedExpectedIdSet(
overrides: ForcedShiftOverride[],
nameToIdsMap: Record<string, string[]>,
agentRecords: AgentRecord[],
targetMinutes: number
): Set<string> {
const result: Set<string> = new Set<string>()

for (const override of overrides) {
    const shiftWindow = parseShiftWindow(override.shiftText)
    if (!shiftWindow) continue
    if (!isNowInShift(targetMinutes, shiftWindow)) continue

    const overrideNameKey = normalizeNameKey(override.name)
    const ids = nameToIdsMap[overrideNameKey] || nameToIdsMap[override.name] || []

    for (const id of ids) {
        const idKey = normalizeId(id)
        if (idKey !== "") result.add(idKey)
    }

    for (const record of agentRecords) {
        if (normalizeNameKey(record.name) !== overrideNameKey) continue
        if (record.idKey !== "") result.add(record.idKey)
    }
}

return result
}

function appendForcedShiftScheduledRows(
scheduledRows: string[][],
overrides: ForcedShiftOverride[],
nameToIdsMap: Record<string, string[]>,
targetMinutes: number,
statusById: Record<string, AgentRecord>
): string[][] {
const result = scheduledRows.slice()
const existingIds: Set<string> = new Set<string>()

for (const row of result) {
    existingIds.add(normalizeId(row[0]))
}

for (const override of overrides) {
    const shiftWindow = parseShiftWindow(override.shiftText)
    if (!shiftWindow) continue
    if (!isNowInShift(targetMinutes, shiftWindow)) continue

    const nameKey = normalizeNameKey(override.name)
    const ids = nameToIdsMap[nameKey] || nameToIdsMap[override.name] || []

    for (const id of ids) {
        const idKey = normalizeId(id)
        if (idKey === "" || existingIds.has(idKey)) continue

        result.push(makeWorkOutputRow(id, override.name, statusById))
        existingIds.add(idKey)
    }
}

return result
}

function hasForcedShiftStartingAtHour(
overrides: ForcedShiftOverride[],
targetHour: number
): boolean {
const targetStartHour = Math.floor(targetHour)

for (const override of overrides) {
    const shiftStartHour = parseShiftStartHourStrict(override.shiftText)
    if (shiftStartHour === targetStartHour) return true
}

return false
}

