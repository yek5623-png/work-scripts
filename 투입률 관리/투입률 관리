function buildHourlyAttendanceCheckRows(
sourceSheet: ExcelScript.Worksheet,
nowMinutes: number,
statusById: Record<string, AgentRecord>,
nameToIdsMap: Record<string, string[]>
): string[][] {
const rows: string[][] = []
const seen: Set<string> = new Set<string>()
const hourlyData = readHourlySourceData(sourceSheet)
const texts = hourlyData.hourlyTexts
const values = hourlyData.hourlyValues
const rowCount = texts.length
const columnCount = 21 // 시간 1열 + BC:BV 이름 20열

for (let r = 0; r < rowCount; r++) {
    const timeText = normalizeText(texts[r][0])
    const timeValue = values[r][0]
    const startMinutes = parseHourStartMinutes(timeText, timeValue)

    if (startMinutes === null) continue
    if (!isNowInOneHourWindow(nowMinutes, startMinutes)) continue

    for (let c = 1; c < columnCount; c++) {
        const rawName = normalizeText(texts[r][c])
        if (rawName === "") continue

        const names = splitNames(rawName)

        for (const name of names) {
            const nameKey = normalizeNameKey(name)
            const ids = nameToIdsMap[nameKey]

            if (!ids || ids.length === 0) {
                const missingIdKey = `missing:${nameKey}`
                if (seen.has(missingIdKey)) continue

                seen.add(missingIdKey)
                rows.push([
                    "",
                    name,
                    "상태 확인 불가",
                    "",
                    "확인필요"
                ])
                continue
            }

            for (const id of ids) {
                const idKey = normalizeId(id)
                if (seen.has(idKey)) continue

                seen.add(idKey)
                rows.push(makeAttendanceCheckOutputRow(id, name, statusById))
            }
        }
    }
}

return rows
}

function makeWorkOutputRow(
id: string,
fallbackName: string,
statusById: Record<string, AgentRecord>
): string[] {
const idKey = normalizeId(id)
const statusRecord = statusById[idKey]
const currentName = statusRecord && statusRecord.name !== "" ? statusRecord.name : fallbackName
const currentStatus = statusRecord ? statusRecord.statusName : "상태 확인 불가"
const currentDuration = statusRecord ? statusRecord.durationText : ""

return [
    id,
    currentName,
    currentStatus,
    currentDuration
]
}

function makeAttendanceCheckOutputRow(
id: string,
fallbackName: string,
statusById: Record<string, AgentRecord>
): string[] {
const idKey = normalizeId(id)
const statusRecord = statusById[idKey]
const currentName = statusRecord && statusRecord.name !== "" ? statusRecord.name : fallbackName
const currentStatus = statusRecord ? statusRecord.statusName : "상태 확인 불가"
const currentDuration = statusRecord ? statusRecord.durationText : ""
const checkText = statusRecord && isPresentWorkStatus(statusRecord.statusName) ? "정상출근" : "확인필요"

return [
    id,
    currentName,
    currentStatus,
    currentDuration,
    checkText
]
}

