function parseOTDisplayHour(timeText: string, timeValue: string | number | boolean): string {
const clean = normalizeText(timeText)

let match = clean.match(/^(\d{1,2})\s*[:：]\s*\d{1,2}/)
if (match) {
    const hour = Number(match[1])
    if (!isNaN(hour)) return String(hour)
}

match = clean.match(/^(\d{1,2})\s*시/)
if (match) {
    const hour = Number(match[1])
    if (!isNaN(hour)) return String(hour)
}

match = clean.match(/^(\d{1,2})$/)
if (match) {
    const hour = Number(match[1])
    if (!isNaN(hour)) return String(hour)
}

if (typeof timeValue === "number" && !isNaN(timeValue)) {
    const dayFraction = timeValue - Math.floor(timeValue)
    const totalMinutes = Math.round(dayFraction * 1440)
    const normalizedMinutes = ((totalMinutes % 1440) + 1440) % 1440
    return String(Math.floor(normalizedMinutes / 60))
}

return ""
}

