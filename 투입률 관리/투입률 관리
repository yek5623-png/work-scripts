function buildShiftMap(
sourceSheet: ExcelScript.Worksheet,
idRegexGlobal: RegExp
): Record<string, string> {
const shiftMap: Record<string, string> = {}
const usedRange = sourceSheet.getUsedRange()
if (!usedRange) return shiftMap
const startRow = usedRange.getRowIndex()
const rowCount = usedRange.getRowCount()
const values = sourceSheet.getRangeByIndexes(startRow, 2, rowCount, 27).getTexts()
for (const row of values) {
const idCell = normalizeText(row[0])
const shiftText = normalizeText(row[3])
if (idCell === "" || shiftText === "") continue
idRegexGlobal.lastIndex = 0
const ids = idCell.match(idRegexGlobal)
if (!ids) continue
for (const id of ids) {
const idKey = normalizeId(id)
if (!shiftMap[idKey]) {
shiftMap[idKey] = shiftText
}
}
}
return shiftMap
}

function syncDailyEducationNames(
workbook: ExcelScript.Workbook,
sheet: ExcelScript.Worksheet,
scheduleRows: string[][]
): void {
sheet.getRange("AF9").setValue("교육중 인원")
const trackingName = "_DailyEducationAutoRows"
const trackingItem = workbook.getNamedItem(trackingName)
const previous: string[] = trackingItem ? JSON.parse(String(trackingItem.getValue())) as string[] : []
const range = sheet.getRange("AF10:AF35")
const rows = range.getTexts()
const clearedIndexes: Set<number> = new Set<number>()
// 최초 실행에서만 기존 코드가 채웠던 고정 명단을 제거합니다.
const legacyNames = buildNameKeySetFromNames([
    "서채윤", "안지예", "김해란", "박지영", "김지운", "김혜연 A"
])
for (let i = 0; i < rows.length; i++) {
    const name = normalizeText(rows[i][0] || "")
    if (trackingItem ? previous[i] && name === previous[i] : legacyNames.has(normalizeNameKey(name))) {
        rows[i][0] = ""
        clearedIndexes.add(i)
    }
}
const seen = buildNameKeySetFromNames(rows.map(row => row[0]))
const autoRows: string[] = rows.map(() => "")
const dailyNames: string[] = []
for (const row of scheduleRows) {
    const name = normalizeText(row[1] || "")
    if (name === "" || statusKey(row[6] || "") !== "교육") continue
    const key = normalizeNameKey(name)
    if (key === "" || seen.has(key)) continue
    seen.add(key)
    dailyNames.push(name)
}
const formulas = range.getFormulas()
const emptyIndexes: number[] = []
for (let i = 0; i < rows.length; i++) {
    if (normalizeText(rows[i][0] || "") === "" && (clearedIndexes.has(i) || formulas[i][0] === "")) emptyIndexes.push(i)
}
if (dailyNames.length > emptyIndexes.length) {
    throw new Error("AF10:AF35 교육인원 입력 공간이 부족합니다. 수기 입력을 확인해 주세요.")
}
clearedIndexes.forEach(index => range.getCell(index, 0).clear(ExcelScript.ClearApplyTo.contents))
for (let i = 0; i < dailyNames.length; i++) {
    const index = emptyIndexes[i]
    range.getCell(index, 0).setValue(dailyNames[i])
    autoRows[index] = dailyNames[i]
}
const formula = `="${JSON.stringify(autoRows).replace(/"/g, '""')}"`
if (trackingItem) trackingItem.setFormula(formula)
else workbook.addNamedItem(trackingName, formula)
}

function getEducationExceptionNames(sheet: ExcelScript.Worksheet): string[] {
const result: string[] = []
const seen: Set<string> = new Set<string>()

try {
    const texts = sheet.getRange("AF10:AF35").getTexts()

    for (const row of texts) {
        const name = normalizeText(row[0] || "")
        if (name === "") continue

        const key = normalizeNameKey(name)
        if (key === "" || seen.has(key)) continue

        seen.add(key)
        result.push(name)
    }
} catch (e) {
}

return result
}

function buildNameKeySetFromNames(names: string[]): Set<string> {
const result: Set<string> = new Set<string>()

for (const name of names) {
    const key = normalizeNameKey(name)
    if (key !== "") result.add(key)
}

return result
}

function buildIdSetFromNames(
names: string[],
nameToIdsMap: Record<string, string[]>
): Set<string> {
const result: Set<string> = new Set<string>()

for (const name of names) {
    const nameKey = normalizeNameKey(name)
    const ids = nameToIdsMap[nameKey] || nameToIdsMap[name] || []

    for (const id of ids) {
        const idKey = normalizeId(id)
        if (idKey !== "") result.add(idKey)
    }
}

return result
}

