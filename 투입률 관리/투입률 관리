function getAvailabilityTextByTargetValue(value: string | number | boolean): string {
const n = typeof value === "number" ? value : parseFloat(String(value ?? "").replace(/,/g, ""))
if (isNaN(n)) return ""

const ranges: { limit: number, low: number, high: number }[] = [
    { limit: 1, low: 53, high: 1000 },
    { limit: 2, low: 69, high: 182 },
    { limit: 3, low: 77, high: 143 },
    { limit: 4, low: 82, high: 130 },
    { limit: 5, low: 85, high: 122 },
    { limit: 6, low: 87, high: 118 },
    { limit: 7, low: 89, high: 115 },
    { limit: 8, low: 82, high: 130 },
    { limit: 9, low: 84, high: 125 },
    { limit: 10, low: 85, high: 122 },
    { limit: 11, low: 87, high: 118 },
    { limit: 12, low: 89, high: 115 },
    { limit: 13, low: 82, high: 130 },
    { limit: 14, low: 84, high: 125 }
]

let low = 95
let high = 105

for (const item of ranges) {
    if (n <= item.limit) {
        low = item.low
        high = item.high
        break
    }
}

return `최소 ~ 최대 투입률 (${low}% ~ ${high}%) 가능`
}

function applyRowColorRuns(
sheet: ExcelScript.Worksheet,
rows: (string | number)[][],
startRowIndex: number,
startColumnIndex: number,
columnCount: number,
getColor: (row: (string | number)[]) => string,
addressesByColor: Record<string, string[]>
): void {
if (rows.length === 0) return
const firstColumn = columnIndexToLetters(startColumnIndex)
const lastColumn = columnIndexToLetters(startColumnIndex + columnCount - 1)
let runStart = 0
let runColor = getColor(rows[0])
for (let i = 1; i <= rows.length; i++) {
    const nextColor = i < rows.length ? getColor(rows[i]) : ""
    if (i < rows.length && nextColor === runColor) continue
    if (runColor !== "") {
        if (!addressesByColor[runColor]) addressesByColor[runColor] = []
        addressesByColor[runColor].push(
            firstColumn + (startRowIndex + runStart + 1) + ":" + lastColumn + (startRowIndex + i)
        )
    }
    runStart = i
    runColor = nextColor
}
}

function applyCollectedRowColors(
sheet: ExcelScript.Worksheet,
addressesByColor: Record<string, string[]>
): void {
// 모든 목록의 같은 색상을 한 번에 묶어 서식 호출을 줄입니다.
for (const color in addressesByColor) {
    const addresses = addressesByColor[color]
    // 주소 길이가 커지지 않도록 최대 100개 영역씩 묶습니다.
    for (let offset = 0; offset < addresses.length; offset += 100) {
        sheet.getRanges(addresses.slice(offset, offset + 100).join(",")).getFormat().getFill().setColor(color)
    }
}
}

function columnIndexToLetters(index: number): string {
let result = ""
let value = index + 1
while (value > 0) {
    result = String.fromCharCode(65 + (value - 1) % 26) + result
    value = Math.floor((value - 1) / 26)
}
return result
}

