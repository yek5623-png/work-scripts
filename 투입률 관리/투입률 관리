}
}
} catch (e) {
}
return exceptions
}

function getReportDateTextByTargetHour(runStartedAtText: string, targetHour: number): string {
let year = 0
let month = 0
let day = 0

try {
    const datePart = runStartedAtText.split(" ")[0]
    const parts = datePart.split("-")

    if (parts.length >= 3) {
        year = parseInt(parts[0], 10)
        month = parseInt(parts[1], 10)
        day = parseInt(parts[2], 10)
    }
} catch (e) {
}

if (isNaN(year) || isNaN(month) || isNaN(day) || year <= 0 || month <= 0 || day <= 0) {
    const koreaNow = new Date(new Date().getTime() + 9 * 60 * 60 * 1000)
    year = koreaNow.getUTCFullYear()
    month = koreaNow.getUTCMonth() + 1
    day = koreaNow.getUTCDate()
}

const reportDate = new Date(Date.UTC(year, month - 1, day))

// 운영일 기준: 05시부터 날짜 변경, 24~28시는 전날 운영일로 표기
if (targetHour >= 24) {
    reportDate.setUTCDate(reportDate.getUTCDate() - 1)
}

return `${reportDate.getUTCMonth() + 1}/${reportDate.getUTCDate()}`
}

function updateNotificationAndEmergencyLog(
sheet: ExcelScript.Worksheet,
missingRows: string[][],
hourlyIdSet: Set<string>,
scheduledIdSet: Set<string>,
presentRecords: AgentRecord[],
targetHour: number,
runStartedAtText: string,
hasStartingShiftAtTargetHour: boolean
): void {
const dateStr = getReportDateTextByTargetHour(runStartedAtText, targetHour)
const fromHour = targetHour
const toHour = targetHour + 1
const currentHeader = `${dateStr} SM ${targetHour}시 투입률 공유드립니다.`
const previousHeader = normalizeText(sheet.getRange("AA3").getTexts()[0][0])
const logStartRow = 6
const maxLogRows = 200
const logRange = sheet.getRange(`AA${logStartRow}:AA${logStartRow + maxLogRows - 1}`)

// 운영일이 바뀌면 시간 접두사가 같은 전날 로그가 새 로그를 막지 않도록 초기화합니다.
const previousDate = previousHeader.split(" SM ")[0]
if (previousHeader === "" || previousDate !== dateStr) {
    logRange.clear(ExcelScript.ClearApplyTo.contents)
}

sheet.getRange("AA3:AA5").setValues([
    [currentHeader],
    [""],
    ["[긴급조치]"]
])

const missingScheduled: string[][] = []
for (const row of missingRows) {
    const idKey = normalizeId(row[0])
    if (!hourlyIdSet.has(idKey)) missingScheduled.push(row)
}

let evaluationStr = ""
if (!hasStartingShiftAtTargetHour) {
    evaluationStr = "시프트없음"
} else if (missingScheduled.length === 0) {
    evaluationStr = "결점 없음"
} else {
    evaluationStr = `미출근 ${missingScheduled.length}명`
}

let summary = `(${fromHour}-${toHour}) ${evaluationStr}`
const otIds: Set<string> = new Set<string>()
hourlyIdSet.forEach((idKey: string) => {
    if (!scheduledIdSet.has(idKey)) otIds.add(idKey)
})

if (otIds.size > 0) {
    let presentOTCount = 0
    let missingOTCount = 0

    for (const rec of presentRecords) {
        if (otIds.has(rec.idKey)) presentOTCount++
    }
    for (const row of missingRows) {
        if (otIds.has(normalizeId(row[0]))) missingOTCount++
    }

    const totalOT = otIds.size
    if (missingOTCount === 0) {
        summary += ` / OT ${totalOT}명`
    } else if (presentOTCount === 0) {
        summary += ` / OT ${totalOT}명 (미출근 ${missingOTCount}명)`
    } else {
        summary += ` / OT ${totalOT}명 (출근 ${presentOTCount}명, 미출근 ${missingOTCount}명)`
    }
}

const logValues = logRange.getTexts()
const hourPrefix = `(${fromHour}-`
let existingOffset = -1
let firstEmptyOffset = -1

// 중간 빈칸이 있어도 끝까지 검사합니다.
for (let i = 0; i < logValues.length; i++) {
    const cellValue = normalizeText(logValues[i][0] || "")
    if (cellValue === "") {
        if (firstEmptyOffset < 0) firstEmptyOffset = i
        continue
    }
    if (cellValue.startsWith(hourPrefix)) existingOffset = i
}

// 같은 시간 재실행은 기존 내용을 최신 상태로 갱신합니다.
if (existingOffset >= 0) {
    sheet.getRangeByIndexes(logStartRow - 1 + existingOffset, 26, 1, 1).setValue(summary)
} else if (firstEmptyOffset >= 0) {
    sheet.getRangeByIndexes(logStartRow - 1 + firstEmptyOffset, 26, 1, 1).setValue(summary)
} else {
    // 비정상적으로 200행이 모두 찬 경우 가장 오래된 로그를 밀어내고 최신 로그를 유지합니다.
    const shiftedValues: string[][] = []
    for (let i = 1; i < logValues.length; i++) shiftedValues.push([logValues[i][0] || ""])
    shiftedValues.push([summary])
    logRange.setValues(shiftedValues)
}
}

function rewriteDailyPlannedAbsenceLog(
sheet: ExcelScript.Worksheet,
plannedAbsences: PlannedAbsence[]
): void {
const headerCell = sheet.getRange("AA33")
const logStartRow = 34
// 다른 출력 영역의 서식 대신 이 로그의 실제 데이터 끝만 확인합니다.
const usedRange = sheet.getRange("AA34:AA1048576").getUsedRange(true)
const usedLastRow = usedRange
    ? usedRange.getRowIndex() + usedRange.getRowCount()
    : logStartRow
const clearEndRow = Math.max(logStartRow, usedLastRow)

// 실행할 때마다 AA33 아래의 이전 목록을 모두 지우고 데일리 원본으로 다시 만듭니다.
sheet
    .getRange(`AA${logStartRow}:AA${clearEndRow}`)
    .clear(ExcelScript.ClearApplyTo.contents)
headerCell.setValue("[데일리 결점]")

if (plannedAbsences.length === 0) return

const outputRows: string[][] = []
for (const item of plannedAbsences) {
    const timeRangeText =
        `${formatMinutesToTimeText(item.startMinutes)}~${formatMinutesToTimeText(item.endMinutes)}`
    const entryKey = `${item.name} ${timeRangeText}`
    const summary = item.reason === ""
        ? entryKey
        : `${entryKey}(${item.reason})`
    outputRows.push([summary])
}

sheet
    .getRangeByIndexes(logStartRow - 1, 26, outputRows.length, 1)
    .setValues(outputRows)
}

function formatMinutesToTimeText(totalMinutes: number): string {
const normalizedMinutes = ((totalMinutes % 1440) + 1440) % 1440
const hour = Math.floor(normalizedMinutes / 60)
const minute = normalizedMinutes % 60
return `${hour}:${pad2(minute)}`
}

