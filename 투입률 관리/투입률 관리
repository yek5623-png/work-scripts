function buildStatusColorMap(sheet: ExcelScript.Worksheet): { [key: string]: string } {
const headers = sheet.getRange("L4:R4").getTexts()
const colourMap: { [key: string]: string } = {}
if (headers.length === 0) return colourMap
const headerRow = headers[0]
for (let colOffset = 0; colOffset < headerRow.length; colOffset++) {
const rawStatus = headerRow[colOffset]
const statusKey = normalizeText(rawStatus)
const colour = sheet
.getRangeByIndexes(2, 11 + colOffset, 1, 1)
.getFormat()
.getFill()
.getColor()
if (statusKey !== "" && colour) {
colourMap[statusKey] = colour
}
}
return colourMap
}

function getOutputRowFillColor(row: (string | number)[], colorMap: { [key: string]: string }): string {
const statusKeyText = normalizeText(String(row[3] ?? ""))
const otText = normalizeText(String(row[4] ?? ""))
const statusColor = colorMap[statusKeyText] || ""

// Only this exact case gets the L3/L4 color:
// 상태값 = 자리에 없음 AND OT여부 = OT 출근중.
// Other OT rows keep their original status color.
if (statusKeyText === "자리에 없음" && otText === "OT 출근중") {
    return colorMap["OT 출근중"] || statusColor
}

return statusColor
}

function getPriorityOutputRowFillColor(
row: (string | number)[],
colorMap: { [key: string]: string },
educationColor: string,
educationIdSet: Set<string>,
educationNameKeySet: Set<string>
): string {
const idKey = normalizeId(String(row[0] ?? ""))
const nameKey = normalizeNameKey(String(row[1] ?? ""))

// AF10:AF35 교육인원은 현재 상태와 관계없이 AF8 색상을 최우선 적용합니다.
if (
    educationColor !== ""
    && (
        (idKey !== "" && educationIdSet.has(idKey))
        || (nameKey !== "" && educationNameKeySet.has(nameKey))
    )
) {
    return educationColor
}

return getOutputRowFillColor(row, colorMap)
}

function getCurrentKoreaHour(): number {
