function getOrCreateNamedOutputSheet(
workbook: ExcelScript.Workbook,
sheetName: string,
fallbackIndex: number
): ExcelScript.Worksheet {
const namedSheet = findWorksheetByName(workbook, sheetName)
if (namedSheet) return namedSheet

const sheets = workbook.getWorksheets()
let sheet: ExcelScript.Worksheet

if (sheets.length > fallbackIndex) {
    sheet = sheets[fallbackIndex]
} else {
    sheet = workbook.addWorksheet(sheetName)
}

if (sheet.getName() !== sheetName && !findWorksheetByName(workbook, sheetName)) {
    sheet.setName(sheetName)
}

return sheet
}

function findWorksheetByName(workbook: ExcelScript.Workbook, sheetName: string): ExcelScript.Worksheet | undefined {
const sheets = workbook.getWorksheets()

for (const sheet of sheets) {
    if (sheet.getName() === sheetName) return sheet
}

return undefined
}

function getInputText(sheet: ExcelScript.Worksheet, inputCell: string): string {
const rawValue = sheet.getRange(inputCell).getValue()

return String(rawValue ?? "")
    .replace(/\u00A0/g, " ")
    .replace(/[\u200B\u200C\u200D]/g, "")
    .replace(/\r\n/g, "\n")
    .replace(/\r/g, "\n")
}

function parseAgentRecords(
rawText: string,
allStatusConfigs: StatusConfig[],
idRegexGlobal: RegExp,
idRegexSingle: RegExp,
nameMap: Record<string, string>
): AgentRecord[] {
const lines = rawText
.split("\n")
.map(v => v.trim())
.filter(v => v !== "")

const records: AgentRecord[] = []
const seenByStatus: Record<string, Set<string>> = {}

for (const config of allStatusConfigs) {
    seenByStatus[statusKey(config.statusName)] = new Set<string>()
}

for (let i = 0; i < lines.length; i++) {
    const line = lines[i]
    idRegexGlobal.lastIndex = 0
    const ids = line.match(idRegexGlobal)

    if (!ids) continue

    for (const id of ids) {
        const blockLines: string[] = [line]

        for (let j = i + 1; j < lines.length && j <= i + 6; j++) {
            if (idRegexSingle.test(lines[j])) break
            blockLines.push(lines[j])
        }

        const matchedConfig = findMatchedStatusConfig(blockLines, allStatusConfigs)
        if (!matchedConfig) continue

        const matchedStatusKey = statusKey(matchedConfig.statusName)
        const idKey = normalizeId(id)

        if (seenByStatus[matchedStatusKey].has(idKey)) continue

        const statusIndex = findStatusLineIndex(blockLines, matchedConfig)
        const durationText = findDurationText(blockLines.slice(0, statusIndex))
        const name = nameMap[idKey] || ""

        seenByStatus[matchedStatusKey].add(idKey)
        records.push({
            id,
            idKey,
            name,
            statusName: matchedConfig.statusName,
            statusKeyValue: matchedStatusKey,
            durationText: durationText === "" ? "시간 확인 불가" : formatDurationText(durationText)
        })
    }
}

return records
}

function writeCurrentWorkingPeople(
workSheet: ExcelScript.Worksheet,
sourceSheet: ExcelScript.Worksheet,
agentRecords: AgentRecord[],
outputStartRow: number,
clearStartColumnIndex: number,
clearColumnCount: number,
mainOutputColumnIndex: number,
missingOutputColumnIndex: number,
unexpectedOutputColumnIndex: number,
outputColumnCount: number,
idRegexGlobal: RegExp,
nameToIdsMap: Record<string, string[]>
) {
const statusById = buildStatusById(agentRecords)
const nowMinutes = getKoreaNowMinutes()
const scheduledRows = buildCurrentWorkingRows(sourceSheet, idRegexGlobal, nowMinutes, statusById)
const hourlyRows = buildHourlyWorkingRows(sourceSheet, nowMinutes, statusById, nameToIdsMap)
const expectedRows = mergeRowsById(scheduledRows, hourlyRows)
const expectedIdSet = buildIdSetFromRows(expectedRows)
const presentRecords = getPresentWorkRecords(agentRecords)
const presentIdSet = buildIdSetFromRecords(presentRecords)
const missingRows = getMissingWorkRows(expectedRows, presentIdSet)
const unexpectedRows = getUnexpectedWorkRows(presentRecords, expectedIdSet)

clearOutput(workSheet, outputStartRow, clearStartColumnIndex, clearColumnCount)

if (expectedRows.length > 0) {
    workSheet
        .getRangeByIndexes(outputStartRow - 1, mainOutputColumnIndex, expectedRows.length, outputColumnCount)
        .setValues(expectedRows)
}

if (missingRows.length > 0) {
    workSheet
        .getRangeByIndexes(outputStartRow - 1, missingOutputColumnIndex, missingRows.length, outputColumnCount)
        .setValues(missingRows)
}

if (unexpectedRows.length > 0) {
    workSheet
        .getRangeByIndexes(outputStartRow - 1, unexpectedOutputColumnIndex, unexpectedRows.length, outputColumnCount)
        .setValues(unexpectedRows)
}
}

function readHourlySourceData(sourceSheet: ExcelScript.Worksheet): { hourlyTexts: string[][]; hourlyValues: (string | number | boolean)[][] } {
// OT 시간은 AY6:AY29, 이름은 BC6:BV29에서 같은 행끼리 결합합니다.
// 마지막 29행의 OT도 시간과 이름을 함께 읽어 출근 판정에 포함합니다.
const timeRange = sourceSheet.getRange("AY6:AY29")
const nameRange = sourceSheet.getRange("BC6:BV29")
const timeTexts = timeRange.getTexts()
const timeValues = timeRange.getValues()
const nameTexts = nameRange.getTexts()
const nameValues = nameRange.getValues()
return {
    hourlyTexts: nameTexts.map((row, index) => [timeTexts[index]?.[0] ?? "", ...row]),
    hourlyValues: nameValues.map((row, index) => [timeValues[index]?.[0] ?? "", ...row])
}
}

function findDailyMetricRow(sourceSheet: ExcelScript.Worksheet, targetHour: number): number {
// AS33:AS56 = 운영시간 05~28시. 00~04시 표기도 24~28시로 인식합니다.
const range = sourceSheet.getRange("AS33:AS56")
const texts = range.getTexts()
const values = range.getValues()
for (let index = 0; index < texts.length; index++) {
    const minutes = parseHourStartMinutes(texts[index][0], values[index][0])
    if (minutes === null || minutes % 60 !== 0) continue
    const hour = minutes / 60
    const businessHour = hour < 5 ? hour + 24 : hour
    if (businessHour === targetHour) return 33 + index
}
throw new Error(
    "데일리!AS33:AS56에서 " + targetHour + "시를 찾지 못했습니다. 5시~28시 시간대를 확인해주세요."
)
}

function readSourceData(sourceSheet: ExcelScript.Worksheet): SourceData {
// 다른 열과 서식만 있는 빈 행 때문에 근무표 읽기 범위가 늘어나지 않게 합니다.
const usedRange = sourceSheet.getRange("C:AC").getUsedRange(true)
let scheduleRows: string[][] = []
let scheduleValues: (string | number | boolean)[][] = []

if (usedRange) {
    const startRow = usedRange.getRowIndex()
    const rowCount = usedRange.getRowCount()
    // C:AC를 한 번에 읽어 C 사번, D 이름, F 시프트, I 근무구분과
    // AB/AC 예정 이탈 시작·종료시간을 처리합니다. 비고는 기존 N열 기준입니다.
    const scheduleRange = sourceSheet.getRangeByIndexes(startRow, 2, rowCount, 27)
    scheduleRows = scheduleRange.getTexts()
    scheduleValues = scheduleRange.getValues()
}

const hourlyData = readHourlySourceData(sourceSheet)
return {
    scheduleRows,
    scheduleValues,
    hourlyTexts: hourlyData.hourlyTexts,
    hourlyValues: hourlyData.hourlyValues
}
}

function buildPlannedAbsences(
scheduleRows: string[][],
scheduleValues: (string | number | boolean)[][]
): PlannedAbsence[] {
const result: PlannedAbsence[] = []
const nameColumnOffset = 1 // D (C:AC 범위 기준)
const startColumnOffset = 8 // K (C:AC 범위 기준)
const endColumnOffset = 9 // L (C:AC 범위 기준)
const remarksColumnOffset = findRemarksColumnOffset(scheduleRows)

for (let rowIndex = 0; rowIndex < scheduleRows.length; rowIndex++) {
    const textRow = scheduleRows[rowIndex] || []
    const valueRow = scheduleValues[rowIndex] || []
    const name = normalizeText(textRow[nameColumnOffset] || "")
    if (name === "") continue

    const startMinutes = parseHourStartMinutes(
        normalizeText(textRow[startColumnOffset] || ""),
        valueRow[startColumnOffset] ?? ""
    )
    const endMinutes = parseHourStartMinutes(
        normalizeText(textRow[endColumnOffset] || ""),
        valueRow[endColumnOffset] ?? ""
    )
    if (startMinutes === null || endMinutes === null || startMinutes === endMinutes) continue

    result.push({
        name,
        nameKey: normalizeNameKey(name),
        startMinutes,
        endMinutes,
        reason: normalizeText(textRow[remarksColumnOffset] || "")
    })
}

return result
}

function findRemarksColumnOffset(scheduleRows: string[][]): number {
const fallbackRemarksColumnOffset = 11 // N

for (const row of scheduleRows) {
    for (let columnOffset = 0; columnOffset < row.length; columnOffset++) {
        const key = statusKey(row[columnOffset] || "")
        if (key === "비고" || key === "비고사항") return columnOffset
    }
}

return fallbackRemarksColumnOffset
}

function getActivePlannedAbsences(
plannedAbsences: PlannedAbsence[],
nowMinutes: number
): PlannedAbsence[] {
return plannedAbsences.filter(item =>
    isMinuteInWindow(nowMinutes, item.startMinutes, item.endMinutes)
)
}

function isMinuteInWindow(nowMinutes: number, startMinutes: number, endMinutes: number): boolean {
if (endMinutes > startMinutes) {
    return nowMinutes >= startMinutes && nowMinutes < endMinutes
}

// 종료시간이 시작시간보다 이르면 자정을 넘기는 구간으로 처리합니다.
return nowMinutes >= startMinutes || nowMinutes < endMinutes
}

function buildPlannedAbsenceNameKeySet(plannedAbsences: PlannedAbsence[]): Set<string> {
const result: Set<string> = new Set<string>()

for (const item of plannedAbsences) {
    if (item.nameKey !== "") result.add(item.nameKey)
}

return result
}

function buildSourceLookupData(
scheduleRows: string[][],
idRegexGlobal: RegExp
): SourceLookupData {
const nameById: Record<string, string> = {}
const idsByName: Record<string, string[]> = {}
const shiftById: Record<string, string> = {}
const seenIdsByName: Record<string, Set<string>> = {}

for (const row of scheduleRows) {
    const idCell = normalizeText(row[0])
    const name = normalizeText(row[1])
    const shiftText = normalizeText(row[3])
    if (idCell === "") continue

    idRegexGlobal.lastIndex = 0
    const ids = idCell.match(idRegexGlobal)
    if (!ids) continue

    const nameKey = normalizeNameKey(name)
    if (nameKey !== "" && !idsByName[nameKey]) {
        idsByName[nameKey] = []
        seenIdsByName[nameKey] = new Set<string>()
    }

    for (const id of ids) {
        const idKey = normalizeId(id)
        if (idKey === "") continue
        if (name !== "") nameById[idKey] = name
        if (shiftText !== "" && !shiftById[idKey]) shiftById[idKey] = shiftText

        if (nameKey !== "" && !seenIdsByName[nameKey].has(idKey)) {
            seenIdsByName[nameKey].add(idKey)
            idsByName[nameKey].push(id)
        }
    }
}

idRegexGlobal.lastIndex = 0
return { nameById, idsByName, shiftById }
}

function buildCurrentWorkingRowsFromSourceRows(
scheduleRows: string[][],
idRegexGlobal: RegExp,
nowMinutes: number,
statusById: Record<string, AgentRecord>
): string[][] {
const rows: string[][] = []

for (const row of scheduleRows) {
    const idCell = normalizeText(row[0])
    const name = normalizeText(row[1])
    const shiftText = normalizeText(row[3])
    const workFlag = normalizeText(row[6]) // I (C:AC 기준)
    if (!isWorkTarget(workFlag)) continue

    idRegexGlobal.lastIndex = 0
    const ids = idCell.match(idRegexGlobal)
    if (!ids) continue

    const shiftWindow = parseShiftWindowForWorkFlag(shiftText, workFlag)
    if (!shiftWindow || !isNowInShift(nowMinutes, shiftWindow)) continue

    for (const id of ids) rows.push(makeWorkOutputRow(id, name, statusById))
}

idRegexGlobal.lastIndex = 0
return rows
}

function buildInactiveHalfDayIdSet(
scheduleRows: string[][],
idRegexGlobal: RegExp,
nowMinutes: number
): Set<string> {
const result: Set<string> = new Set<string>()

for (const row of scheduleRows) {
    const workFlag = normalizeText(row[6]) // I (C:AC 기준)
    if (getHalfDayType(workFlag) === null) continue

    const idCell = normalizeText(row[0])
    const shiftText = normalizeText(row[3])
    if (idCell === "" || shiftText === "") continue

    const shiftWindow = parseShiftWindowForWorkFlag(shiftText, workFlag)
    if (!shiftWindow || isNowInShift(nowMinutes, shiftWindow)) continue

    idRegexGlobal.lastIndex = 0
    const ids = idCell.match(idRegexGlobal)
    if (!ids) continue

    for (const id of ids) {
        const idKey = normalizeId(id)
        if (idKey !== "") result.add(idKey)
    }
}

idRegexGlobal.lastIndex = 0
return result
}

function buildHourlyWorkingRowsFromSourceData(
texts: string[][],
values: (string | number | boolean)[][],
nowMinutes: number,
statusById: Record<string, AgentRecord>,
nameToIdsMap: Record<string, string[]>
): string[][] {
const rows: string[][] = []
const seen: Set<string> = new Set<string>()

for (let r = 0; r < texts.length; r++) {
    const startMinutes = parseHourStartMinutes(
        normalizeText(texts[r][0]),
        values[r][0]
    )
    if (startMinutes === null || !isNowInOneHourWindow(nowMinutes, startMinutes)) continue

    for (let c = 1; c < texts[r].length; c++) {
        const rawName = normalizeText(texts[r][c])
        if (rawName === "") continue

        for (const name of splitNames(rawName)) {
            const ids = nameToIdsMap[normalizeNameKey(name)]
            if (!ids) continue
            for (const id of ids) {
                const idKey = normalizeId(id)
                if (idKey === "" || seen.has(idKey)) continue
                seen.add(idKey)
                rows.push(makeWorkOutputRow(id, name, statusById))
            }
        }
    }
}

return rows
}

function buildDailyOTHourMapFromSourceData(
texts: string[][],
values: (string | number | boolean)[][],
nameToIdsMap: Record<string, string[]>
): Record<string, string> {
const result: Record<string, string> = {}
const hoursById: Record<string, Set<string>> = {}

for (let r = 0; r < texts.length; r++) {
    const hourLabel = parseOTDisplayHour(normalizeText(texts[r][0]), values[r][0])
    if (hourLabel === "") continue

    for (let c = 1; c < texts[r].length; c++) {
        const rawName = normalizeText(texts[r][c])
        if (rawName === "") continue

        for (const name of splitNames(rawName)) {
            const ids = nameToIdsMap[normalizeNameKey(name)]
            if (!ids) continue
            for (const id of ids) {
                const idKey = normalizeId(id)
                if (!hoursById[idKey]) hoursById[idKey] = new Set<string>()
                hoursById[idKey].add(hourLabel)
            }
        }
    }
}

for (const idKey in hoursById) {
    const labels = Array.from(hoursById[idKey])
    labels.sort((a, b) => Number(a) - Number(b))
    result[idKey] = labels.join(",")
}

return result
}

function hasShiftStartingAtHourFromSourceRows(
scheduleRows: string[][],
idRegexGlobal: RegExp,
targetHour: number
): boolean {
const targetStartHour = Math.floor(targetHour)

for (const row of scheduleRows) {
    const idCell = normalizeText(row[0])
    const shiftText = normalizeText(row[3])
    const workFlag = normalizeText(row[6]) // I (C:AC 기준)
    if (idCell === "" || shiftText === "" || !isWorkTarget(workFlag)) continue

    idRegexGlobal.lastIndex = 0
    const ids = idCell.match(idRegexGlobal)
    if (!ids || ids.length === 0) continue

    const shiftWindow = parseShiftWindowForWorkFlag(shiftText, workFlag)
    if (!shiftWindow) continue

    const shiftStartMinutes = ((shiftWindow.startMinutes % 1440) + 1440) % 1440
    if (shiftStartMinutes === targetStartHour * 60) {
        idRegexGlobal.lastIndex = 0
        return true
    }
}

idRegexGlobal.lastIndex = 0
return false
}

function buildCurrentWorkingRows(
sourceSheet: ExcelScript.Worksheet,
idRegexGlobal: RegExp,
nowMinutes: number,
statusById: Record<string, AgentRecord>
): string[][] {
const rows: string[][] = []
const usedRange = sourceSheet.getUsedRange()

if (!usedRange) return rows

const startRow = usedRange.getRowIndex()
const rowCount = usedRange.getRowCount()

const values = sourceSheet.getRangeByIndexes(startRow, 2, rowCount, 27).getTexts()

for (const row of values) {
    const idCell = normalizeText(row[0])
    const name = normalizeText(row[1])
    const shiftText = normalizeText(row[3])
    const workFlag = normalizeText(row[6]) // I (C:AC 기준)

    if (!isWorkTarget(workFlag)) continue

    idRegexGlobal.lastIndex = 0
    const ids = idCell.match(idRegexGlobal)
    if (!ids) continue

    const shiftWindow = parseShiftWindowForWorkFlag(shiftText, workFlag)
    if (!shiftWindow) continue
    if (!isNowInShift(nowMinutes, shiftWindow)) continue

    for (const id of ids) {
        rows.push(makeWorkOutputRow(id, name, statusById))
    }
}

return rows
}

function buildHourlyWorkingRows(
sourceSheet: ExcelScript.Worksheet,
nowMinutes: number,
