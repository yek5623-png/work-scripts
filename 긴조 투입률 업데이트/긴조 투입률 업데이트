function panel(sheet: ExcelScript.Worksheet,address: string,text: string,fill: string,color: string,size: number) {
  updateStep("테스트 화면 구획 구성", "테스트!" + address);
  const range = sheet.getRange(address); range.merge();
  if (text) range.getCell(0,0).setValue(text);
  const format = range.getFormat(); format.getFill().setColor(fill); format.getFont().setColor(color); format.getFont().setSize(size);
  format.setWrapText(true); format.setVerticalAlignment(ExcelScript.VerticalAlignment.center);
}
