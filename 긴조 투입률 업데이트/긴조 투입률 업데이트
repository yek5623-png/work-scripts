function describeUpdateError(error: unknown): string {
  if (error === null || error === undefined) return "오류 상세가 비어 있습니다.";
  if (typeof error !== "object") return String(error);
  const parts: string[] = [];
  const info = error as UpdateErrorInfo;
  try { if (info.name) parts.push("name=" + String(info.name)); } catch { }
  try { if (info.message) parts.push("message=" + String(info.message)); } catch { }
  try { if (info.code) parts.push("code=" + String(info.code)); } catch { }
  try { if (info.errorLocation) parts.push("errorLocation=" + String(info.errorLocation)); } catch { }
  try { if (info.debugInfo) parts.push("debugInfo=" + JSON.stringify(info.debugInfo)); } catch { }
  try { if (info.innerError) parts.push("innerError=" + JSON.stringify(info.innerError)); } catch { }
  try { const json = JSON.stringify(error); if (json && json !== "{}") parts.push("detail=" + json); } catch { }
  return parts.length > 0 ? parts.join(" / ") : "호스트가 오류 세부정보를 제공하지 않았습니다. 아래 실패 단계와 위치를 확인하세요.";
