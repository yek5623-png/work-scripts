    r.reason,
    r.evidence,
    r.postFlag,
    r.check,
    normalizeWorkStatusForOutput(r.workStatus),
    duplicateSet.has(idx) ? "중복" : ""
]);

sheetCheck.getRangeByIndexes(1, 0, output.length, headers[0].length).setValues(output);

for (let i = 0; i < sortedRecords.length; i++) {
    const r = sortedRecords[i];

    if (r.check === "누락") {
        sheetCheck
            .getRangeByIndexes(1 + i, 0, 1, headers[0].length)
            .getFormat()
            .getFill()
            .setColor("#FFEB9C");
    }

    if (duplicateSet.has(i)) {
        sheetCheck
            .getRangeByIndexes(1 + i, 0, 1, headers[0].length)
            .getFormat()
            .getFill()
            .setColor("#FFC7CE");
    }
}

try {
    sheetCheck.getUsedRange()?.getFormat().autofitColumns();
} catch (e) {
    // 무시
}
}

function writeBillTab(sheetBill: ExcelScript.Worksheet, records: OutputRecord[], baseDate: DateInfo) {
const MAX_ROWS = 10000;
const START_ROW = 9; // 10행 시작

clearBillColumns(sheetBill, START_ROW, MAX_ROWS);

if (records.length === 0) return;

const sortedRecords = sortOutputRecordsByNameForBill(records);

// OT청구 List 일자는 운영일자로 씁니다.
// 24:00~28:59 구간은 엑셀 출력일자가 다음날로 잡혀도 실제 청구일자는 전일입니다.
// 예: 6/27 24:00~25:00, 25:00~25:30처럼 잡힌 행도 청구일자는 6/26으로 씁니다.
const dates = sortedRecords.map(r => [getBillDateTextForRecord(r)]);
const names = sortedRecords.map(r => [r.name]);
const starts = sortedRecords.map(r => [formatMinutesToTimeNoLeadingZero(r.startMin)]);
const ends = sortedRecords.map(r => [formatMinutesToTimeNoLeadingZero(r.endMin)]);
const reasons = sortedRecords.map(r => [r.reason]);
const evidences = sortedRecords.map(r => [r.evidence]);
const statuses = sortedRecords.map(r => [normalizeWorkStatusForOutput(r.workStatus)]);

sheetBill.getRangeByIndexes(START_ROW, 8, dates.length, 1).setValues(dates);
sheetBill.getRangeByIndexes(START_ROW, 10, names.length, 1).setValues(names);
sheetBill.getRangeByIndexes(START_ROW, 16, starts.length, 1).setValues(starts);
sheetBill.getRangeByIndexes(START_ROW, 17, ends.length, 1).setValues(ends);
sheetBill.getRangeByIndexes(START_ROW, 21, reasons.length, 1).setValues(reasons);
sheetBill.getRangeByIndexes(START_ROW, 22, evidences.length, 1).setValues(evidences);
sheetBill.getRangeByIndexes(START_ROW, 24, statuses.length, 1).setValues(statuses);
}

function getBillDateTextForRecord(r: OutputRecord): string {
return getBillOperationalDate(r).text;
}

function getBillOperationalDate(r: OutputRecord): DateInfo {
// OT청구 List 기준 운영일자:
// - 05:00~23:59는 해당 출력일자 그대로
// - 24:00~28:59는 다음날로 넘어가 보이더라도 전일 날짜로 청구
// startMin은 24:00 이후 구간이면 1440 이상으로 들어옵니다.
if (r.startMin >= 24 * 60 && r.startMin < 29 * 60) {
    return addDaysToDateInfo(r.outputDate, -1);
}

return r.outputDate;
}

function dateInfoToDayNumber(dateInfo: DateInfo): number {
return Math.floor(Date.UTC(dateInfo.year, dateInfo.month - 1, dateInfo.day) / (24 * 60 * 60 * 1000));
}

function clearBillColumns(sheetBill: ExcelScript.Worksheet, startRow: number, rowCount: number) {
sheetBill.getRangeByIndexes(startRow, 8, rowCount, 1).clear(ExcelScript.ClearApplyTo.contents);
sheetBill.getRangeByIndexes(startRow, 10, rowCount, 1).clear(ExcelScript.ClearApplyTo.contents);
sheetBill.getRangeByIndexes(startRow, 16, rowCount, 2).clear(ExcelScript.ClearApplyTo.contents);
sheetBill.getRangeByIndexes(startRow, 21, rowCount, 2).clear(ExcelScript.ClearApplyTo.contents);
sheetBill.getRangeByIndexes(startRow, 24, rowCount, 1).clear(ExcelScript.ClearApplyTo.contents);
}

function analyzeReason(value: string): ReasonInfo {
const text = String(value ?? "").trim();
const compact = text.replace(/\s+/g, "");

const tickets = extractTicketNumbers(text);
const hasPostText = compact.includes("후처리");
const isPost = hasPostText || tickets.length > 0;

if (isPost) {
    return {
        mappedReason: "응대미종결",
        evidence: tickets.join(", "),
        isPost: true,
        hasPostText
    };
}

if (compact.includes("결점OT") || compact.includes("결점")) {
    return {
        mappedReason: "투입률관리",
        evidence: "",
        isPost: false,
        hasPostText: false
    };
}

if (compact.includes("협력사요청") || compact.includes("협력사")) {
    return {
        mappedReason: "응대율방어(Eats요청)",
        evidence: "",
        isPost: false,
        hasPostText: false
    };
}

return {
    mappedReason: "",
    evidence: "",
    isPost: false,
    hasPostText: false
};
}

function extractTicketNumbers(value: string): string[] {
const text = String(value ?? "");
const result: string[] = [];
const seen = new Set<string>();

const regex = /(?:^|[^0-9])#?(\d{8})(?!\d)/g;
let match: RegExpExecArray | null;

while ((match = regex.exec(text)) !== null) {
    const ticket = match[1];

    if (!seen.has(ticket)) {
        seen.add(ticket);
        result.push(ticket);
    }
}

return result;
}

function lookupEmployee(
idValue: string | number | boolean,
nameValue: string | number | boolean,
maps: EmployeeMaps
): EmployeeInfo {
const idText = normalize(idValue);
const name = formatPersonName(nameValue);
const nameKey = normalizeNameKey(nameValue);

if (idText && maps.byId.has(idText)) {
    return maps.byId.get(idText) as EmployeeInfo;
}

if (nameKey && maps.byName.has(nameKey)) {
    return maps.byName.get(nameKey) as EmployeeInfo;
}

return {
    idText,
    name,
    nameKey,
    workStatus: "휴무"
};
}

function sameDate(a: string, b: string): boolean {
return a === b;
}

function samePerson(
baseId: string,
baseNameKey: string,
aId: string,
aNameKey: string
): boolean {
if (baseId && aId && baseId === aId) return true;
if (baseNameKey && aNameKey && baseNameKey === aNameKey) return true;
return false;
}

function rangesOverlap(startA: number, endA: number, startB: number, endB: number): boolean {
return Math.max(startA, startB) < Math.min(endA, endB);
}

function splitRangeByHour(startMin: number, endMin: number): { startMin: number; endMin: number }[] {
const result: { startMin: number; endMin: number }[] = [];

let cursor = startMin;

while (cursor < endMin) {
    const nextHour = Math.floor(cursor / 60) * 60 + 60;
    const next = Math.min(nextHour, endMin);

    result.push({
        startMin: cursor,
        endMin: next
    });

    cursor = next;
}

return result;
}

function findDuplicateRowIndexes(records: OutputRecord[]): number[] {
const countMap = new Map<string, number>();

for (const r of records) {
    const key = makeDuplicateKey(r);
    countMap.set(key, (countMap.get(key) ?? 0) + 1);
}

const result: number[] = [];

for (let i = 0; i < records.length; i++) {
    const key = makeDuplicateKey(records[i]);

    if ((countMap.get(key) ?? 0) > 1) {
        result.push(i);
    }
}

return result;
}

function makeDuplicateKey(r: OutputRecord): string {
const personKey = normalize(r.idText) || normalizeNameKey(r.name);

return [
    r.outputDate.key,
    personKey,
    r.startMin,
    r.endMin,
    normalize(r.reason),
    normalize(r.evidence),
    normalize(r.postFlag),
    normalize(r.check)
].join("|");
}

function classifyWorkStatus(value: string | number | boolean): string {
const v = normalize(value).toUpperCase();

if (v === "1" || v === "근무") return "근무";
if (v.includes("연차")) return "연차";

const holidayWords = ["X", "근무X", "공휴", "토휴", "일휴", "휴무", "대휴", "휴"];

for (const word of holidayWords) {
    if (v.includes(word)) return "휴무";
}

return "휴무";
}

function normalizeWorkStatusForOutput(value: string | number | boolean): string {
const v = normalize(value).toUpperCase();

if (v === "1" || v === "근무") return "근무";
if (v.includes("연차")) return "연차";

return "휴무";
}

function normalize(value: string | number | boolean): string {
return String(value ?? "")
.replace(/\s+/g, "")
.trim();
}

function normalizeNameKey(value: string | number | boolean): string {
return formatPersonName(value)
.replace(/\s+/g, "")
.toUpperCase()
.trim();
}

function formatPersonName(value: string | number | boolean): string {
let text = String(value ?? "").trim();

if (!text) return "";

text = text.replace(/\s+/g, " ");

const noSpace = text.replace(/\s+/g, "");
const match = noSpace.match(/^(.+?)([a-zA-Z])$/);

if (match) {
    const baseName = match[1];
    const suffix = match[2].toUpperCase();

    return `${baseName} ${suffix}`;
}

return text;
}

function splitNamesInCell(value: string | number | boolean): string[] {
const text = String(value ?? "").trim();

if (!text) return [];

return text
    .split(/[\n\r,，]+/)
    .map(v => v.trim())
    .filter(v => v !== "");
}

function isBlank(value: string | number | boolean): boolean {
return String(value ?? "").trim() === "";
}

function parseATimeToMinutes(
textValue: string,
rawValue: string | number | boolean
): number | null {
const textParsed = parseTimeTextToMinutes(textValue);

if (textParsed !== null) {
    return fixEarlyHourToOperationalTime(textParsed);
}

if (typeof rawValue === "number") {
    if (!isFinite(rawValue)) return null;

    if (rawValue >= 0 && rawValue < 2) {
        return fixEarlyHourToOperationalTime(Math.round(rawValue * 24 * 60));
    }

    if (Number.isInteger(rawValue) && rawValue >= 0 && rawValue <= 48) {
        return fixEarlyHourToOperationalTime(rawValue * 60);
    }

    return null;
}

if (typeof rawValue === "boolean") return null;

const rawTextParsed = parseTimeTextToMinutes(String(rawValue ?? ""));

if (rawTextParsed !== null) {
    return fixEarlyHourToOperationalTime(rawTextParsed);
}

return null;
}

function parseDTableTimeToMinutes(
textValue: string,
rawValue: string | number | boolean
): number | null {
const textParsed = parseTimeTextToMinutes(textValue);

if (textParsed !== null) {
    return fixEarlyHourToOperationalTime(textParsed);
}

if (typeof rawValue === "number") {
    if (!isFinite(rawValue)) return null;

    if (rawValue >= 0 && rawValue < 2) {
        return fixEarlyHourToOperationalTime(Math.round(rawValue * 24 * 60));
    }

    if (Number.isInteger(rawValue) && rawValue >= 0 && rawValue <= 48) {
        return fixEarlyHourToOperationalTime(rawValue * 60);
    }

    return null;
}

if (typeof rawValue === "boolean") return null;

const rawTextParsed = parseTimeTextToMinutes(String(rawValue ?? ""));

if (rawTextParsed !== null) {
    return fixEarlyHourToOperationalTime(rawTextParsed);
}

return null;
}

function fixEarlyHourToOperationalTime(minutes: number): number {
if (minutes >= 0 && minutes < 5 * 60) {
return minutes + 24 * 60;
}

return minutes;
}

function parseTimeTextToMinutes(value: string): number | null {
let text = String(value ?? "").trim();

if (!text) return null;

text = text
    .replace(/\s+/g, "")
    .replace("：", ":");

let isPM = false;
let isAM = false;

if (text.includes("오후")) {
    isPM = true;
    text = text.replace("오후", "");
}

if (text.includes("오전")) {
    isAM = true;
    text = text.replace("오전", "");
}

let match = text.match(/^(\d{1,2}):(\d{1,2})$/);

if (match) {
    let hour = Number(match[1]);
    const minute = Number(match[2]);

    if (isNaN(hour) || isNaN(minute)) return null;
    if (minute < 0 || minute >= 60) return null;

    if (isPM && hour < 12) hour += 12;
    if (isAM && hour === 12) hour = 0;

    return hour * 60 + minute;
}

match = text.match(/^(\d{1,2})시(?:(\d{1,2})분?)?$/);

if (match) {
    let hour = Number(match[1]);
    const minute = match[2] === undefined ? 0 : Number(match[2]);

    if (isNaN(hour) || isNaN(minute)) return null;
    if (minute < 0 || minute >= 60) return null;

    if (isPM && hour < 12) hour += 12;
    if (isAM && hour === 12) hour = 0;

    return hour * 60 + minute;
}

match = text.match(/^(\d{3,4})$/);

if (match) {
    const raw = match[1];

    const hourText = raw.length === 3 ? raw.substring(0, 1) : raw.substring(0, 2);
    const minuteText = raw.length === 3 ? raw.substring(1, 3) : raw.substring(2, 4);

    const hour = Number(hourText);
    const minute = Number(minuteText);

    if (isNaN(hour) || isNaN(minute)) return null;
    if (minute < 0 || minute >= 60) return null;

    return hour * 60 + minute;
}

match = text.match(/^(\d{1,2})$/);

if (match) {
    const hour = Number(match[1]);

    if (isNaN(hour)) return null;

    return hour * 60;
}

return null;
}

function getOutputDateByStart(baseDate: DateInfo, startMin: number): DateInfo {
const dayOffset = Math.floor(startMin / (24 * 60));

if (dayOffset <= 0) return baseDate;

return addDaysToDateInfo(baseDate, dayOffset);
}

function parseDateToInfo(
rawValue: string | number | boolean,
textValue: string,
fallback: DateInfo
): DateInfo {
const text = String(textValue ?? "").trim();

if (!text && isBlank(rawValue)) {
    return fallback;
}

if (typeof rawValue === "number" && isFinite(rawValue) && rawValue > 1000) {
    const date = excelSerialToDate(Math.floor(rawValue));

    const year = date.getUTCFullYear();
    const month = date.getUTCMonth() + 1;
    const day = date.getUTCDate();

    return makeDateInfo(year, month, day);
}

const parsedText = parseDateText(text || String(rawValue ?? ""), fallback.year);

if (parsedText) {
    return parsedText;
}

return fallback;
}

function parseDateText(value: string, defaultYear: number): DateInfo | null {
let text = String(value ?? "").trim();

if (!text) return null;

text = text
    .replace(/\s+/g, "")
    .replace("년", "-")
    .replace("월", "-")
    .replace("일", "")
    .replace(/[./]/g, "-");

let match = text.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);

if (match) {
    const year = Number(match[1]);
    const month = Number(match[2]);
    const day = Number(match[3]);

    if (!isValidDateParts(year, month, day)) return null;

    return makeDateInfo(year, month, day);
}

match = text.match(/^(\d{1,2})-(\d{1,2})$/);

if (match) {
    const year = defaultYear;
    const month = Number(match[1]);
    const day = Number(match[2]);

    if (!isValidDateParts(year, month, day)) return null;

    return makeDateInfo(year, month, day);
}

return null;
}

function makeDateInfo(year: number, month: number, day: number): DateInfo {
return {
key: `${year}-${pad2(month)}-${pad2(day)}`,
text: `${month}/${day}`,
year,
month,
day
};
}

function addDaysToDateInfo(dateInfo: DateInfo, days: number): DateInfo {
const date = new Date(Date.UTC(dateInfo.year, dateInfo.month - 1, dateInfo.day + days));

return makeDateInfo(
    date.getUTCFullYear(),
    date.getUTCMonth() + 1,
    date.getUTCDate()
);
}

function isValidDateParts(year: number, month: number, day: number): boolean {
if (isNaN(year) || isNaN(month) || isNaN(day)) return false;
if (month < 1 || month > 12) return false;
if (day < 1 || day > 31) return false;

return true;
}

function excelSerialToDate(serial: number): Date {
const utcMs = Math.round((serial - 25569) * 86400 * 1000);
return new Date(utcMs);
}

function getTodayKstInfo(): DateInfo {
const kstNow = new Date(Date.now() + 9 * 60 * 60 * 1000);

const year = kstNow.getUTCFullYear();
const month = kstNow.getUTCMonth() + 1;
const day = kstNow.getUTCDate();

return makeDateInfo(year, month, day);
}

function formatMinutesToTimeNoLeadingZero(totalMinutes: number): string {
const hour = Math.floor(totalMinutes / 60);
const minute = totalMinutes % 60;

return `${hour}:${pad2(minute)}`;
}

function pad2(value: number): string {
return value < 10 ? `0${value}` : String(value);
}

function clearFillSafe(range: ExcelScript.Range) {
try {
range.getFormat().getFill().clear();
} catch (e) {
// fill clear 실패 시 무시
}
}