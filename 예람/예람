function writeCheckTab(sheetCheck: ExcelScript.Worksheet, records: OutputRecord[]) {
const used = sheetCheck.getUsedRange();

if (used) {
    used.clear(ExcelScript.ClearApplyTo.all);
}

const headers = [[
    "날짜",
    "사번",
    "이름",
    "시작시간",
    "종료시간",
    "OT사유",
    "증빙자료",
    "후처리 여부",
    "OT 취합 확인",
    "근무여부",
    "비고"
]];

sheetCheck.getRangeByIndexes(0, 0, 1, headers[0].length).setValues(headers);

if (records.length === 0) return;

const sortedRecords = sortOutputRecordsByTime(records);
const duplicateRows = findDuplicateRowIndexes(sortedRecords);
