  }
  // 오류/실제 값은 사전 확인합니다. 업무 명단은 진단 탭에 복제하지 않습니다.
  const liveBefore = repairRead(parsed.getRange("P2"), 14);
  const shownBefore = repairRead(status.getRange("D10"), 6);
  const beforeCount = repairKeys(shownBefore).length;
  const stats: string[] = [];
