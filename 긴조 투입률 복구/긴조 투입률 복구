  const previous = named.getFormula();
  const listCell = list.getRange("A2");
  const displayCell = status.getRange("D10");
  const previousList = listCell.getFormula();
  const previousDisplay = displayCell.getFormula();
  const expectedList = '=LET(source,수식판정!P2#,rows,HSTACK(CHOOSECOLS(source,1,3,4,5),IF((1-CHOOSECOLS(source,8))*CHOOSECOLS(source,9),"OT 출근중",""),CHOOSECOLS(source,6)),수식_명단정렬(rows,TRUE,FALSE))';
  const normalize = (formula: string): string => formula.replace(/\s+/g, "").replace(/_xlfn\./gi, "").toLowerCase();
  const already = normalize(previous) === normalize(repairedSorter);
  if (!already && normalize(previous) !== normalize(originalSorter)) {
    throw new Error("명단 정렬 함수가 댓글의 기존 버전과 다릅니다. 사용자 수식을 덮어쓰지 않았습니다. 디버깅 결과를 확인하세요.");
  }
  if (normalize(previousDisplay).replace(/['$]/g, "") !== "=수식명단!a2#" || normalize(previousList).replace(/['$]/g, "") !== normalize(expectedList)) {
