// 이후 A1 변경도 수식으로 반영됩니다. 예전 설치 스크립트를 다시 실행하면 이 복구를 재실행하세요.
type RepairValue = string | number | boolean;
const originalSorter: string = "=LAMBDA(rows,sortShift,includeOther,LET(blank,MAKEARRAY(1,6,LAMBDA(rownum,colnum,\"\")), status,CHOOSECOLS(rows,4), ranks,MAP(status,LAMBDA(item,SWITCH(수식_비교글자(item),\"대화가능\",1,\"식사\",3,\"식사중\",3,\"휴식\",4,\"휴식중\",4,\"교육\",5,\"교육중\",5,\"자리에없음\",6,\"출근\",7,\"정상출근\",7,99))), groups,VSTACK(1,3,4,5,6,7,99), combined,REDUCE(blank,groups,LAMBDA(acc,rank,LET(mask,(ranks=rank)*(CHOOSECOLS(rows,1)<>\"\")*IF(rank=99,includeOther,TRUE), IF(SUM(--mask)=0,acc,LET(block,FILTER(rows,mask), sorted,IF(sortShift,LET(starts,MAP(CHOOSECOLS(block,3),LAMBDA(item,LET(pair,수식_근무시간(item,\"교육\"),start,INDEX(pair,1,1),IF(start<0,1440,start)))),SORTBY(block,starts,1,SEQUENCE(ROWS(block)),1)),block), IF(OR(rank=3,rank=5),VSTACK(acc,sorted,blank),VSTACK(acc,sorted))))))), IF(ROWS(combined)=1,blank,DROP(combined,1))))";
const repairedSorter: string = "=LAMBDA(rows,sortShift,includeOther,LET(blank,MAKEARRAY(1,6,LAMBDA(rownum,colnum,\"\")), status,CHOOSECOLS(rows,4), ranks,MAP(status,LAMBDA(item,SWITCH(수식_비교글자(item),\"대화가능\",1,\"온라인\",2,\"인터랙션\",2,\"인터랙션중\",2,\"커뮤니케이션\",2,\"커뮤니케이션중\",2,\"식사\",3,\"식사중\",3,\"휴식\",4,\"휴식중\",4,\"교육\",5,\"교육중\",5,\"자리에없음\",6,\"출근\",7,\"정상출근\",7,99))), groups,VSTACK(1,2,3,4,5,6,7,99), combined,REDUCE(blank,groups,LAMBDA(acc,rank,LET(mask,(ranks=rank)*(CHOOSECOLS(rows,1)<>\"\")*IF(rank=99,includeOther,TRUE), IF(SUM(--mask)=0,acc,LET(block,FILTER(rows,mask), sorted,IF(sortShift,LET(starts,MAP(CHOOSECOLS(block,3),LAMBDA(item,LET(pair,수식_근무시간(item,\"교육\"),start,INDEX(pair,1,1),IF(start<0,1440,start)))),SORTBY(block,starts,1,SEQUENCE(ROWS(block)),1)),block), IF(OR(rank=3,rank=5),VSTACK(acc,sorted,blank),VSTACK(acc,sorted))))))), IF(ROWS(combined)=1,blank,DROP(combined,1))))";
function main(workbook: ExcelScript.Workbook) {
  const status = workbook.getWorksheet("상태출력");
  const parsed = workbook.getWorksheet("수식판정");
