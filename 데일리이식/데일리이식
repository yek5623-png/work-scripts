function main(workbook: ExcelScript.Workbook) {
  const debug: string[] = [];
  const oldDebugSheet = workbook.getWorksheet("데일리_디버그");
  if (oldDebugSheet) oldDebugSheet.delete();
  const application = workbook.getApplication();
  const originalCalculationMode = application.getCalculationMode();
  try {
    // 외부 연결 확인은 명시적으로 계산하고, 중간 입력의 자동 재계산만 억제
    application.setCalculationMode(ExcelScript.CalculationMode.manual);
    importDailyValues(workbook, debug);
  } finally {
    try {
      // 실행 후 외부 수식을 남기면 다른 작업 때도 계속 계산됩니다.
      const tempSheet = workbook.getWorksheet("__값불러오기임시__");
      if (tempSheet) {
        for (const address of ["B1:M150", "AN1:BT150", "AO33:AY57", "DV1:DV8", "DV5:EZ5"]) {
          tempSheet.getRange(address).clear(ExcelScript.ClearApplyTo.contents);
        }
      }
    } finally {
      application.setCalculationMode(originalCalculationMode);
    }
  }
}

function importDailyValues(workbook: ExcelScript.Workbook, debug: string[]) {
  const targetSheetName = "데일리";
  const targetSheet = workbook.getWorksheet(targetSheetName);

  if (!targetSheet) {
    throw new Error(`"${targetSheetName}" 탭을 찾지 못했습니다. 탭 이름을 확인해주세요.`);
  }

  // 기존 구간과 상단 I4·I5·AQ4를 함께 읽습니다.
  const importRanges: ImportRangeConfig[] = [
    { targetAddress: "B6:M140", expectedRows: 135, expectedCols: 12, probeRow: 0 },
    { targetAddress: "AO6:AU30", expectedRows: 25, expectedCols: 7, probeRow: 1 },
    { targetAddress: "BC6:BQ29", expectedRows: 24, expectedCols: 15, probeRow: 2 },
    { targetAddress: "AO33:AY57", expectedRows: 25, expectedCols: 11, probeRow: 3 },
    { targetAddress: "I4", expectedRows: 1, expectedCols: 1, probeRow: 4 },
    { targetAddress: "I5", expectedRows: 1, expectedCols: 1, probeRow: 5 },
    { targetAddress: "AQ4", expectedRows: 1, expectedCols: 1, probeRow: 6 }
  ];

  // 무조건 데일리!A1만 읽음
  const inputCell = targetSheet.getRange("A1");
  const inputRaw = String(inputCell.getText()).trim();
  const inputValue = inputCell.getValue();

  if (!inputRaw && (inputValue === "" || inputValue === null || inputValue === undefined)) {
    throw new Error("데일리 탭 A1에 날짜를 적어주세요. 예: 26, 7/1, 7월1일, 긴급 07(1)");
  }

  // 한국시간 오전 5시 기준 기본 년월
  // 단, A1에 7/1, 7월1일처럼 월/일 날짜가 있으면 그 날짜의 월로 원본 링크를 잡음
  const businessInfo = getKstBusinessInfo();
  const sourceDateInfo = resolveSourceDateInfo(inputRaw, inputValue, businessInfo);
  const sourceYyMm = sourceDateInfo.yyMm;
  debug.push("데일리!A1: " + inputRaw, "파일 월: " + sourceYyMm + " / " + sourceDateInfo.reason);

  const sourceFilePath =
    `https://coupartnersnam.sharepoint.com/sites/TCK_COUPANGEATS/EATS3/ERM/Daily 출근시트/Eats Daily 출근시트 ${sourceYyMm}/[긴급조치 Daily. (${sourceYyMm}).xlsx]`;

  const tempSheetName = "__값불러오기임시__";

  let tempSheet = workbook.getWorksheet(tempSheetName);
  if (!tempSheet) {
    tempSheet = workbook.addWorksheet(tempSheetName);
  }

  try {
    tempSheet.setVisibility(ExcelScript.SheetVisibility.visible);
  } catch (e) {}

  // 이전 범위의 시작 수식을 먼저 제거해 새 범위의 스필과 충돌하지 않게 합니다.
  for (const address of ["A1", "Y1", "AA1", "AO1", "BE1"]) {
    const legacyFormulaCell = tempSheet.getRange(address);
    if (legacyFormulaCell.getFormula()) {
      legacyFormulaCell.clear(ExcelScript.ClearApplyTo.contents);
    }
  }
  // 이전 버전의 넓은 범위 수식까지 제거해 후보 검사 때 재계산되지 않게 합니다.
  for (const address of ["B1:M150", "AN1:BT150", "AO33:AY57"]) {
    tempSheet.getRange(address).clear(ExcelScript.ClearApplyTo.contents);
  }
  tempSheet.getRange("DV2:DV4").clear(ExcelScript.ClearApplyTo.contents);
  tempSheet.getRange("DV5").clear(ExcelScript.ClearApplyTo.contents);
  tempSheet.getRange("DF1:DH5").clear(ExcelScript.ClearApplyTo.contents);

  // 숫자만 입력하면 5시 기준 월 사용
  // 7/1, 7월1일, 긴급 07(1)처럼 날짜면 해당 월 사용
  const candidates = makeSheetNameCandidates(inputRaw, sourceYyMm, sourceDateInfo);
  debug.push("원본: " + sourceFilePath, "탭 후보: " + candidates.join(" | "));

  if (candidates.length === 0) {
    throw new Error(
      "원본 탭 후보명을 만들지 못했습니다." +
        "\n5시기준 기본 월: " + businessInfo.yyMm +
        "\n실제 사용 월: " + sourceYyMm +
        "\nA1 입력값: " + inputRaw +
        "\n입력해석: " + sourceDateInfo.reason
    );
  }

  let selectedSheetName = "";
  let resolveDebug: string[] = [];

  // 후보 탭 존재검사
  debug.push("단계: 원본 탭 및 링크 권한 검사");
  const resolved = resolveSourceSheetName(
    workbook,
    tempSheet,
    sourceFilePath,
    candidates
  );

  selectedSheetName = resolved.sheetName;
  resolveDebug = resolved.debug;
  debug.push(...resolveDebug);

  // 숫자만 입력한 경우, 외부참조가 순간적으로 늦게 붙으면 존재검사가 실패할 수 있어서
  // 1순위 후보로 직접 값읽기까지 한 번 더 시도하게 함
  if (!selectedSheetName && /^\d{1,2}$/.test(normalizeInputText(inputRaw))) {
    selectedSheetName = candidates[0];
    resolveDebug.push("후보검사 실패 → 숫자입력 1순위 후보 직접 읽기 시도: " + selectedSheetName);
  }

  if (!selectedSheetName) {
    throw new Error(
      "원본 탭을 찾지 못했습니다." +
        "\n5시기준 기본 월: " + businessInfo.yyMm +
        "\n실제 사용 월: " + sourceYyMm +
        "\n데일리!A1 입력값: " + inputRaw +
        "\n입력해석: " + sourceDateInfo.reason +
        "\n원본파일 링크: " + sourceFilePath +
        "\n시도한 탭명: " + candidates.join(" | ") +
        "\n\n검사결과:\n" + resolveDebug.join("\n")
    );
  }

  const escapedSelectedSheetName = escapeSheetName(selectedSheetName);
  debug.push("선택된 탭: " + selectedSheetName, "단계: 지정 구간 외부 수식 연결");
  const sourceRefs: string[] = [];

  // 지정 구간만 외부참조
  for (const importRange of importRanges) {
    const sourceRef =
      `'${sourceFilePath}${escapedSelectedSheetName}'!${importRange.targetAddress}`;

    sourceRefs.push(sourceRef);
    bindImportFormula(tempSheet, importRange, sourceRef, false);
  }

  const readResult = readExternalValuesStable(
    workbook,
    tempSheet,
    importRanges,
    selectedSheetName,
    sourceYyMm,
    sourceFilePath,
    sourceRefs
  );
  debug.push(...readResult.debug);
  debug.push("단계: 대상 값 입력 및 검증");


  for (let i = 0; i < importRanges.length; i++) {
    writeValuesToTarget(
      targetSheet,
      importRanges[i].targetAddress,
      readResult.valuesByRange[i]
    );
  }

  try {
    tempSheet.setVisibility(ExcelScript.SheetVisibility.hidden);
  } catch (e) {}
}

interface ImportRangeConfig {
  targetAddress: string;
  expectedRows: number;
  expectedCols: number;
  probeRow: number;
}

function bindImportFormula(
  tempSheet: ExcelScript.Worksheet,
  importRange: ImportRangeConfig,
  sourceRef: string,
  useCellFormulas: boolean
): void {
  const range = tempSheet.getRange(importRange.targetAddress);
  const startCol = range.getColumnIndex();
  const startRow = range.getRowIndex();
  range.clear(ExcelScript.ClearApplyTo.contents);
  if (!useCellFormulas) {
    // 정상 연결에서는 각 범위를 시작 수식 하나씩으로 읽습니다.
    const anchor = tempSheet.getCell(startRow, startCol);
    anchor.setFormula(`=LET(src,${sourceRef},IF(ISBLANK(src),"",src))`);
    const anchorAddress = columnName(startCol) + String(startRow + 1);
    tempSheet.getCell(importRange.probeRow, 125).setFormula(
      importRange.expectedRows === 1 && importRange.expectedCols === 1
        ? `=IF(ISERROR(${anchorAddress}),"__ERR__","1|1")`
        : `=IFERROR(ROWS(${anchorAddress}#)&"|"&COLUMNS(${anchorAddress}#),"__ERR__")`
    );
    return;
  }
  // 외부 배열을 읽을 수 없을 때만 셀별 일반 참조로 복구합니다.
  const bang = sourceRef.lastIndexOf('!');
  const prefix = sourceRef.slice(0, bang + 1);
  const formulas: string[][] = [];
  for (let r = 0; r < importRange.expectedRows; r++) {
    const row: string[] = [];
    for (let c = 0; c < importRange.expectedCols; c++) {
      const ref = prefix + columnName(startCol + c) + String(startRow + r + 1);
      row.push(`=IF(ISBLANK(${ref}),"",${ref})`);
    }
    formulas.push(row);
  }
  // 최대 200셀씩 나눠 입력해 단일 요청의 시간 초과를 줄입니다.
  const batchRows = Math.max(1, Math.floor(200 / importRange.expectedCols));
  for (let offset = 0; offset < formulas.length; offset += batchRows) {
    const batch = formulas.slice(offset, offset + batchRows);
    tempSheet.getRangeByIndexes(startRow + offset, startCol, batch.length, importRange.expectedCols)
      .setFormulas(batch);
  }
}

function columnName(index: number): string {
  let result = "";
  for (let n = index + 1; n > 0; n = Math.floor((n - 1) / 26)) {
    result = String.fromCharCode(65 + (n - 1) % 26) + result;
  }
  return result;
}

function isExcludedDailyCell(row: number, col: number): boolean {
  return row === 3 && (col === 9 || col === 43);
}

function writeValuesToTarget(
  targetSheet: ExcelScript.Worksheet,
  targetAddress: string,
  values: (string | number | boolean)[][]
) {
  const targetRange = targetSheet.getRange(targetAddress);
  const startRow = targetRange.getRowIndex();
  const startCol = targetRange.getColumnIndex();
  const rowCount = targetRange.getRowCount();
  const colCount = targetRange.getColumnCount();

  // 데일리!A1은 입력칸이라 절대 덮어쓰기 금지
  const fixedInputCellKey = "0,0";

  const failures: string[] = [];
  const skipCells = new Set<string>();
  for (let r = 0; r < rowCount; r++) {
    for (let c = 0; c < colCount; c++) {
      if (isExcludedDailyCell(startRow + r, startCol + c) || isExcelErrorValue(values[r][c])) skipCells.add(`${startRow + r},${startCol + c}`);
    }
  }
  const mergedTopLeft = new Set<string>();
  let mergeInspectionSucceeded = false;

  try {
    const mergedAreas = targetRange.getMergedAreas();

    if (mergedAreas) {
      // 병합 주소를 한 번에 읽어 각 영역의 좌표를 메모리에서 해석합니다.
      const areas = mergedAreas.getAddress().split(",").map(address => parseRangeBounds(address));

      for (const area of areas) {
        const areaRow = area.row;
        const areaCol = area.col;
        const areaRows = area.rows;
        const areaCols = area.cols;

        const excludedMerge = areaRow <= 3 && areaRow + areaRows > 3 &&
          ((areaCol <= 9 && areaCol + areaCols > 9) || (areaCol <= 43 && areaCol + areaCols > 43)) &&
          !(areaRow === 3 && (areaCol === 8 || areaCol === 42));
        if (!excludedMerge && !skipCells.has(`${areaRow},${areaCol}`)) mergedTopLeft.add(`${areaRow},${areaCol}`);

        for (let r = 0; r < areaRows; r++) {
          for (let c = 0; c < areaCols; c++) {
            const rr = areaRow + r;
            const cc = areaCol + c;

            if (r === 0 && c === 0 && !excludedMerge) continue;
            skipCells.add(`${rr},${cc}`);
          }
        }
      }
    }

    mergeInspectionSucceeded = true;
  } catch (e) {
    throw new Error("병합 상태를 확인할 수 없어 입력을 중단했습니다: " + targetAddress + " / " + String(e));
  }

  // 병합셀이 없는 구간은 범위 전체를 한 번에 입력하고, 실패하면 기존 방식으로 복귀
  if (
    mergeInspectionSucceeded &&
    mergedTopLeft.size === 0 &&
    skipCells.size === 0
  ) {
    try {
      const cleanedValues = values.map(row =>
        row.map(value => cleanCellValue(value))
      );

      if (startRow === 0 && startCol === 0) {
        // A1은 입력칸이므로 첫 행의 나머지와 2행 이후를 나눠서 일괄 입력
        if (colCount > 1) {
          targetSheet
            .getRangeByIndexes(startRow, startCol + 1, 1, colCount - 1)
            .setValues([cleanedValues[0].slice(1)]);
        }

        if (rowCount > 1) {
          targetSheet
            .getRangeByIndexes(startRow + 1, startCol, rowCount - 1, colCount)
            .setValues(cleanedValues.slice(1));
        }
      } else {
        targetRange.setValues(cleanedValues);
      }

      verifyWrittenValues(targetRange, cleanedValues, skipCells);
      return;
    } catch (e) {
      // 보호셀 등으로 일괄 입력이 실패하면 아래의 기존 행별 입력으로 재시도
    }
  }

  // 병합 아닌 일반 셀은 행 단위 덩어리로 입력
  for (let r = 0; r < rowCount; r++) {
    let c = 0;

    while (c < colCount) {
      const absRow = startRow + r;
      const absCol = startCol + c;
      const key = `${absRow},${absCol}`;

      if (key === fixedInputCellKey || skipCells.has(key) || mergedTopLeft.has(key)) {
        c++;
        continue;
      }

      const segmentStart = c;
      const segmentValues: (string | number | boolean)[] = [];

      while (c < colCount) {
        const nowAbsRow = startRow + r;
        const nowAbsCol = startCol + c;
        const nowKey = `${nowAbsRow},${nowAbsCol}`;

        if (
          nowKey === fixedInputCellKey ||
          skipCells.has(nowKey) ||
          mergedTopLeft.has(nowKey)
        ) {
          break;
        }

        segmentValues.push(cleanCellValue(values[r][c]));
        c++;
      }

      if (segmentValues.length > 0) {
        writeRowSegment(targetSheet, absRow, startCol + segmentStart, segmentValues, failures);
      }
    }
  }

  // 병합셀 왼쪽 위칸만 개별 입력
  mergedTopLeft.forEach(key => {
    if (key === fixedInputCellKey) return;

    const parts = key.split(",");
    const absRow = Number(parts[0]);
    const absCol = Number(parts[1]);

    const r = absRow - startRow;
    const c = absCol - startCol;

    if (r < 0 || r >= rowCount || c < 0 || c >= colCount) return;

    writeSingleCell(targetSheet, absRow, absCol, cleanCellValue(values[r][c]), failures);
  });
  if (failures.length > 0) {
    throw new Error("일부 셀 입력에 실패했습니다. 일부 값은 이미 입력됐을 수 있습니다.\n" + failures.slice(0, 20).join("\n"));
  }
  verifyWrittenValues(targetRange, values, skipCells);
}

function parseRangeBounds(address: string): { row: number; col: number; rows: number; cols: number } {
  const localAddress = address.slice(address.lastIndexOf("!") + 1).trim();
  const match = localAddress.match(/^\$?([A-Z]+)\$?(\d+)(?::\$?([A-Z]+)\$?(\d+))?$/i);
  if (!match) throw new Error("병합 주소를 해석할 수 없습니다: " + address);
  const col = columnIndex(match[1]);
  const row = Number(match[2]) - 1;
  return { row, col, rows: Number(match[4] || match[2]) - row, cols: columnIndex(match[3] || match[1]) - col + 1 };
}

function columnIndex(name: string): number {
  let index = 0;
  for (const letter of name.toUpperCase()) index = index * 26 + letter.charCodeAt(0) - 64;
  return index - 1;
}

function writeRowSegment(
  sheet: ExcelScript.Worksheet, row: number, col: number,
  values: (string | number | boolean)[], failures: string[]
): void {
  try {
    sheet.getRangeByIndexes(row, col, 1, values.length).setValues([values]);
  } catch (e) {
    for (let i = 0; i < values.length; i++) writeSingleCell(sheet, row, col + i, values[i], failures);
  }
}

function writeSingleCell(
  sheet: ExcelScript.Worksheet, row: number, col: number,
  value: string | number | boolean, failures: string[]
): void {
  try {
    sheet.getCell(row, col).setValue(value);
  } catch (e) {
    failures.push(columnName(col) + String(row + 1) + ": " + String(e));
  }
}

function verifyWrittenValues(
  range: ExcelScript.Range,
  expected: (string | number | boolean)[][],
  skipCells: Set<string>
): void {
  const actual = range.getValues();
  const startRow = range.getRowIndex();
  const startCol = range.getColumnIndex();
  const mismatches: string[] = [];
  for (let r = 0; r < expected.length; r++) {
    for (let c = 0; c < expected[r].length; c++) {
      const rr = startRow + r;
      const cc = startCol + c;
      if (skipCells.has(`${rr},${cc}`) || isExcelErrorValue(expected[r][c])) continue;
      if (actual[r][c] !== cleanCellValue(expected[r][c])) {
        mismatches.push(columnName(cc) + String(rr + 1));
      }
    }
  }
  if (mismatches.length > 0) {
    throw new Error("입력 후 값 검증 실패 (일부 값은 이미 입력됐을 수 있음): " + mismatches.slice(0, 20).join(", "));
  }
}

interface KstBusinessInfo {
  yyMm: string;
  yy: string;
  yyyy: number;
  mm: string;
  month: number;
}

interface SourceDateInfo {
  yyMm: string;
  yyyy: number;
  yy: string;
  month: number;
  monthPad: string;
  monthNum: string;
  day: number;
  dayNum: string;
  dayPad: string;
  hasExplicitMonthDay: boolean;
  reason: string;
}

function resolveSourceSheetName(
  workbook: ExcelScript.Workbook,
  tempSheet: ExcelScript.Worksheet,
  sourceFilePath: string,
  candidates: string[]
): { sheetName: string; debug: string[] } {
  const debug: string[] = [];
  const cacheAddress = "DW1:DX1";
  const cacheKey = sourceFilePath + "|" + candidates.join("|");
  const cacheValues = tempSheet.getRange(cacheAddress).getValues()[0];
  const cachedName = String(cacheValues[1]).trim();
  const orderedCandidates = String(cacheValues[0]) === cacheKey && candidates.includes(cachedName)
    ? [cachedName, ...candidates.filter(name => name !== cachedName)]
    : candidates.slice();
  // 탭 후보를 한 번에 검사하고 검사 셀만 계산합니다.
  const tests = tempSheet.getRangeByIndexes(4, 125, 1, orderedCandidates.length);
  tests.setFormulas([orderedCandidates.map(name => {
    const ref = `'${sourceFilePath}${escapeSheetName(name)}'!A1`;
    return `=IF(ISERROR(${ref}),"__ERR__",1)`;
  })]);
  // 첫 외부참조로 링크를 등록한 직후, 대량 복구 수식을 만들기 전에 권한을 확인합니다.
  refreshExternalLinks(workbook, sourceFilePath);
  const checkCandidate = (attempt: number): string => {
    const results = calculateCandidateValues(tests);
    for (let i = 0; i < results.length; i++) {
      debug.push(`${attempt}회차: ${orderedCandidates[i]} => ${String(results[i])}`);
      if (results[i] === 1) {
        return orderedCandidates[i];
      }
    }
    return attempt < 3 ? checkCandidate(attempt + 1) : "";
  };
  const sheetName = checkCandidate(1);
  tests.clear(ExcelScript.ClearApplyTo.contents);
  if (sheetName) tempSheet.getRange(cacheAddress).setValues([[cacheKey, sheetName]]);
  return { sheetName, debug };
}

function calculateCandidateValues(tests: ExcelScript.Range): (string | number | boolean)[] {
  tests.calculate();
  return tests.getValues()[0];
}

function readExternalValuesStable(
  workbook: ExcelScript.Workbook,
  tempSheet: ExcelScript.Worksheet,
  importRanges: ImportRangeConfig[],
  selectedSheetName: string,
  sourceYyMm: string,
  sourceFilePath: string,
  sourceRefs: string[]
): {
  valuesByRange: (string | number | boolean)[][][];
  debug: string[];
} {
  const debug: string[] = [];
  debug.push("실제 읽기 범위: " + importRanges.map(config => config.targetAddress).join(" | "));
  let valuesByRange: (string | number | boolean)[][][] = [];
  let previousSnapshot = "";
  let stableReads = 0;
  let lastErrors: string[] = [];
  let lastErrorCount = 0;
  // 큰 사각 범위 대신 요청한 지정 구간만 읽습니다.
  const bounds = importRanges.map(config => parseRangeBounds(config.targetAddress));

  // 빠른 범위 참조가 실패할 때만 셀별 참조로 복구합니다.
  for (let cycle = 1; cycle <= 2; cycle++) {
    if (cycle === 2) {
      debug.push("빠른 범위 참조 실패 → 셀별 외부참조로 복구");
      previousSnapshot = "";
      stableReads = 0;

      for (let i = 0; i < importRanges.length; i++) {
        bindImportFormula(tempSheet, importRanges[i], sourceRefs[i], true);
      }
    }

    // 재계산과 외부 연결 새로고침은 별개입니다. 실패하면 이전 값을 복사하지 않습니다.
    refreshExternalLinks(workbook, sourceFilePath);

    // 외부참조 값이 늦게 들어오는 경우 대비해서 여러 번 재계산
    for (let attempt = 1; attempt <= 4; attempt++) {
      const read = readCalculatedSnapshot(tempSheet, bounds);
      valuesByRange = read.valuesByRange;
      // 오류와 전체 값 변화를 검사합니다.
      const formulaCellTexts = valuesByRange.map(values => String(values[0][0]).trim());

      const checks = valuesByRange.map((values, i) => inspectValues(values, bounds[i].row, bounds[i].col));
      lastErrors = [];
      lastErrorCount = 0;
      for (const check of checks) {
        lastErrorCount += check.errorCount;
        for (const sample of check.errors) if (lastErrors.length < 20) lastErrors.push(sample);
      }
      const hasAnyValue = checks.some(check => check.hasAnyValue);
      const errorLike = checks.some(check => check.errorLike);
      const probes = cycle === 1 ? read.probes : [];
      const spillsReady = cycle === 2 || probes.every((row, i) =>
        String(row[0]) === `${importRanges[i].expectedRows}|${importRanges[i].expectedCols}`
      );
      const allRangesReady = spillsReady && valuesByRange.every((values, index) =>
        values.length === importRanges[index].expectedRows &&
        values.every(row => row.length === importRanges[index].expectedCols)
      );
      const snapshot = JSON.stringify(valuesByRange);
      const readyCounts = checks
        .map(check => String(check.nonEmptyCount))
        .join("|");

      debug.push(
        `${cycle}-${attempt}회차: hasAnyValue=${hasAnyValue}, ` +
          `counts=${readyCounts}, ` +
          `formulaCells=${formulaCellTexts.join(" | ")}, ` +
          `allRangesReady=${allRangesReady}, errorLike=${errorLike}, errorCount=${lastErrorCount}`
      );
      if (lastErrorCount > 0) {
        for (let i = 0; i < checks.length; i++) {
          if (checks[i].errorCount === 0) continue;
          debug.push(importRanges[i].targetAddress + ": 오류 " + checks[i].errorCount + "개");
        }
        debug.push("건너뛸 오류 셀 (최대 20개): " + lastErrors.join(" | "));
      }

      // 범위 크기와 계산 안정성을 확인합니다. 개별 오류 셀은 입력 시 건너뜁니다.
      if (!allRangesReady || !hasAnyValue) {
        previousSnapshot = "";
        stableReads = 0;
        continue;
      }

      // 셀 개수가 아니라 값 전체를 비교합니다. 3회 연속 같아야 복사합니다.
      stableReads = snapshot === previousSnapshot ? stableReads + 1 : 1;
      previousSnapshot = snapshot;
      if (stableReads >= 3) {
        return { valuesByRange, debug };
      }
    }
  }

  throw new Error(
    (lastErrorCount > 0
      ? "외부파일 값이 안정화되지 않아 이식을 중단했습니다. 감지한 오류 셀: " + lastErrorCount + "개. 데일리 값은 변경하지 않았습니다."
      : "외부파일 값이 비어있거나 범위 크기 또는 계산 안정화 조건을 충족하지 못했습니다.") +
      "\n선택된 탭명: " + selectedSheetName +
      "\n파일 월: " + sourceYyMm +
      (lastErrorCount > 0 ? "\n오류 셀 (최대 20개, 선택된 원본 탭 기준):\n" + lastErrors.join("\n") +
        "\n원본의 같은 셀도 오류인지 확인해주세요. 원본이 정상이면 외부참조 중 발생한 오류일 수 있습니다." : "") +
      "\n참조식: " + sourceRefs.join(" | ") +
      "\n\n재계산 결과:\n" + debug.join("\n") +
      (lastErrorCount > 0
        ? "\n\n개별 오류 셀은 건너뛰지만, 범위 크기 또는 계산 안정화 조건을 충족하지 못해 중단했습니다."
        : "\n\n가능성:" +
      "\n1) 원본 파일이 SharePoint에서 제한시간 안에 완전히 열리지 않음" +
      "\n2) 해당 월 폴더/파일 경로가 실제와 다름" +
      "\n3) 원본 탭명에 눈에 안 보이는 공백이 있음" +
      "\n4) 외부참조 권한/연결이 계속 끊긴 상태")
  );
}

function refreshExternalLinks(workbook: ExcelScript.Workbook, sourceFilePath: string): void {
  // 수식의 [파일명] 표기를 실제 파일 URL로 바꿉니다.
  const sourceUrl = sourceFilePath.replace(/\[([^\[\]]+)\]$/, "$1");
  try {
    // 다른 월의 오래된 링크나 다른 사용자가 만든 링크는 새로고침하지 않습니다.
    // URL의 공백이 %20으로 등록된 경우도 같은 원본으로 인식합니다.
    const expectedUrl = normalizeWorkbookUrl(sourceUrl);
    const links = workbook.getLinkedWorkbooks();
    const matchingLinks = links.filter(link => normalizeWorkbookUrl(link.getId()) === expectedUrl);
    if (matchingLinks.length !== 1) {
      throw new Error("이번 달 원본 링크를 하나로 확인하지 못했습니다. 일치 개수: " + matchingLinks.length);
    }
    matchingLinks[0].refreshLinks();
  } catch (e) {
    // 실패한 채 캐시값을 복사하지 않고, Excel이 반환한 실제 오류를 표시합니다.
    const detail = describeLinkError(e);
    if (detail.indexOf("RefreshWorkbookLinksBlocked") !== -1) {
      throw new Error(
        "Excel에서 외부 통합 문서 링크 새로고침을 차단했습니다. 데일리 값은 변경하지 않았습니다." +
        "\n이 권한은 스크립트로 해제할 수 없습니다." +
        "\n1) 대상 파일을 Excel 웹에서 직접 열고 통합 문서 링크 신뢰/사용 허용을 승인해주세요." +
        "\n2) 데이터 → 통합 문서 링크에서 아래 원본을 선택해 직접 새로고침해주세요." +
        "\n3) 수동 새로고침 성공 후 이 스크립트를 다시 실행해주세요." +
        "\n조직 정책으로 허용할 수 없으면 관리자에게 링크 새로고침 허용을 요청해주세요." +
        "\n원본: " + sourceUrl + "\n상세: " + detail
      );
    }
    throw new Error(
      "원본 파일 링크 새로고침 요청 실패.\n원본: " + sourceUrl +
      "\n상세: " + detail +
      "\n\n실행한 계정으로 원본을 열고, 대상 파일의 데이터 → 통합 문서 링크에서" +
      " 링크 신뢰 여부와 위 원본의 개별 새로고침 오류를 확인해주세요." +
      "\n파일 접근 권한과 외부 링크 신뢰·로그인 상태는 별도입니다."
    );
  }
}

function normalizeWorkbookUrl(url: string): string {
  try {
    return decodeURI(url.trim());
  } catch (e) {
    return url.trim();
  }
}

interface LinkRefreshError {
  name?: string;
  code?: string;
  message?: string;
  debugInfo?: { code?: string; message?: string; errorLocation?: string };
}

function describeLinkError(error: LinkRefreshError | string): string {
  if (typeof error === "string") return error;
  if (!error) return "Excel에서 오류 상세를 반환하지 않았습니다.";
  const details: string[] = [];
  if (error.name) details.push("name=" + error.name);
  if (error.code) details.push("code=" + error.code);
  if (error.message) details.push("message=" + error.message);
  if (error.debugInfo) {
    if (error.debugInfo.code) details.push("debugCode=" + error.debugInfo.code);
    if (error.debugInfo.message) details.push("debugMessage=" + error.debugInfo.message);
    if (error.debugInfo.errorLocation) details.push("location=" + error.debugInfo.errorLocation);
  }
  if (details.length > 0) return details.join(" / ");
  try {
    const serialized = JSON.stringify(error);
    if (serialized && serialized !== "{}") return serialized;
  } catch (e) {}
  return "Excel에서 오류 상세를 반환하지 않았습니다.";
}

function readCalculatedSnapshot(
  sheet: ExcelScript.Worksheet,
  bounds: { row: number; col: number; rows: number; cols: number }[]
): { valuesByRange: (string | number | boolean)[][][]; probes: (string | number | boolean)[][] } {
  sheet.calculate(true);
  return {
    valuesByRange: bounds.map(bound => sheet.getRangeByIndexes(bound.row, bound.col, bound.rows, bound.cols).getValues()),
    probes: sheet.getRange("DV1:DV" + String(bounds.length)).getValues()
  };
}

function inspectValues(
  values: (string | number | boolean)[][],
  startRow: number = 0,
  startCol: number = 0
): { hasAnyValue: boolean; errorLike: boolean; nonEmptyCount: number; errorCount: number; errors: string[] } {
  let nonEmptyCount = 0;
  let errorCount = 0;
  const errors: string[] = [];

  let errorLike = false;

  for (let r = 0; r < values.length; r++) {
    for (let c = 0; c < values[r].length; c++) {
      if (isExcludedDailyCell(startRow + r, startCol + c)) continue;
      const v = values[r][c];
      // 시작 셀뿐 아니라 범위 내부의 오류도 검사합니다.
      if (isExcelErrorValue(v)) {
        errorLike = true;
        errorCount++;
        if (errors.length < 20) errors.push(columnName(startCol + c) + String(startRow + r + 1) + " = " + v);
      }

      if (v !== "" && v !== null && v !== undefined) {
        nonEmptyCount++;
      }
    }
  }

  return { hasAnyValue: nonEmptyCount > 0, errorLike, nonEmptyCount, errorCount, errors };
}

function isExcelErrorValue(value: string | number | boolean): boolean {
  return typeof value === "string" && /^(#REF!|#VALUE!|#NAME\?|#N\/A|#CONNECT!|#BUSY!|#CALC!|#BLOCKED!|#UNKNOWN!|#SPILL!|#DIV\/0!|#NUM!|#NULL!|#GETTING_DATA|__ERR__)$/.test(value.trim().toUpperCase());
}

function cleanCellValue(value: string | number | boolean): string | number | boolean {
  if (value === null || value === undefined) {
    return "";
  }

  return value;
}

function getKstBusinessInfo(): KstBusinessInfo {
  const now = new Date();

  // UTC timestamp에 한국시간 +9시간 적용
  const kstNow = new Date(now.getTime() + 9 * 60 * 60 * 1000);

  // 한국시간 오전 5시 전이면 전날 기준
  let businessDate = kstNow;
  if (kstNow.getUTCHours() < 5) {
    businessDate = new Date(kstNow.getTime() - 24 * 60 * 60 * 1000);
  }

  const yyyy = businessDate.getUTCFullYear();
  const yy = String(yyyy).slice(-2);
  const month = businessDate.getUTCMonth() + 1;
  const mm = String(month).padStart(2, "0");

  return {
    yyMm: `${yy}.${mm}`,
    yy,
    yyyy,
    mm,
    month
  };
}

function resolveSourceDateInfo(
  inputRaw: string,
  inputValue: string | number | boolean,
  businessInfo: KstBusinessInfo
): SourceDateInfo {
  const normalized = normalizeInputText(inputRaw);

  // A1이 2, 4, 26처럼 숫자만이면 기존 그대로 5시 기준 월 사용
  if (/^\d{1,2}$/.test(normalized)) {
    const day = Number(normalized);

    return buildSourceDateInfo(
      businessInfo.yyyy,
      businessInfo.month,
      day,
      false,
      "숫자만 입력됨 → 5시 기준 월 사용"
    );
  }

  // 7월1일, 2026년 7월 1일, 7/1, 2026/7/1, 긴급 07(1) 등 텍스트 날짜 우선 해석
  const textParsed = parseDateFromText(normalized, businessInfo.yyyy);
  if (textParsed.ok) {
    return buildSourceDateInfo(
      textParsed.yyyy,
      textParsed.month,
      textParsed.day,
      true,
      "A1 날짜값 해석 → 해당 월 링크 사용"
    );
  }

  // A1이 엑셀 날짜값인데 표시형식 때문에 숫자 시리얼로 보이는 경우 보조 처리
  if (typeof inputValue === "number" && inputValue >= 60 && inputValue <= 100000) {
    const serialParsed = parseExcelSerialDate(inputValue);
    if (serialParsed.ok) {
      return buildSourceDateInfo(
        serialParsed.yyyy,
        serialParsed.month,
        serialParsed.day,
        true,
        "엑셀 날짜 시리얼 해석 → 해당 월 링크 사용"
      );
    }
  }

  // 그래도 해석 안 되면 기존 5시 기준 월로 후보 생성
  return buildSourceDateInfo(
    businessInfo.yyyy,
    businessInfo.month,
    0,
    false,
    "날짜 해석 실패 → 5시 기준 월 사용"
  );
}

function buildSourceDateInfo(
  yyyy: number,
  month: number,
  day: number,
  hasExplicitMonthDay: boolean,
  reason: string
): SourceDateInfo {
  const yy = String(yyyy).slice(-2);
  const monthPad = String(month).padStart(2, "0");
  const monthNum = String(Number(month));
  const safeDay = day || 0;
  const dayNum = safeDay > 0 ? String(Number(safeDay)) : "";
  const dayPad = safeDay > 0 ? String(Number(safeDay)).padStart(2, "0") : "";

  return {
    yyMm: `${yy}.${monthPad}`,
    yyyy,
    yy,
    month,
    monthPad,
    monthNum,
    day: safeDay,
    dayNum,
    dayPad,
    hasExplicitMonthDay,
    reason
  };
}

function parseDateFromText(
  text: string,
  fallbackYear: number
): { ok: boolean; yyyy: number; month: number; day: number } {
  const normalized = normalizeInputText(text);

  // 2026년 7월 1일 / 7월1일
  const koreanMatch = normalized.match(/(?:(\d{2,4})\s*년\s*)?(\d{1,2})\s*월\s*(\d{1,2})\s*일?/);
  if (koreanMatch) {
    const yyyy = koreanMatch[1] ? normalizeYear(Number(koreanMatch[1]), fallbackYear) : fallbackYear;
    const month = Number(koreanMatch[2]);
    const day = Number(koreanMatch[3]);

    if (isValidMonthDay(month, day)) {
      return { ok: true, yyyy, month, day };
    }
  }

  // 2026/7/1, 26.7.1, 7/1, 7-1, 긴급 07(1)
  const nums = normalized.match(/\d{1,4}/g);

  if (!nums || nums.length < 2) {
    return { ok: false, yyyy: fallbackYear, month: 0, day: 0 };
  }

  let yyyy = fallbackYear;
  let month = 0;
  let day = 0;

  if (nums.length >= 3) {
    const n1 = Number(nums[0]);
    const n2 = Number(nums[1]);
    const n3 = Number(nums[2]);

    // 2026/7/1 또는 26/7/1
    if (nums[0].length === 4 || n1 > 31 || (nums[0].length === 2 && n1 >= 24 && n2 >= 1 && n2 <= 12)) {
      yyyy = normalizeYear(n1, fallbackYear);
      month = n2;
      day = n3;
    }
    // 7/1/2026
    else if (nums[2].length === 4 || n3 > 31) {
      yyyy = normalizeYear(n3, fallbackYear);
      month = n1;
      day = n2;
    }
    // 애매한 3개 숫자는 마지막 2개를 월/일로 봄
    else {
      month = Number(nums[nums.length - 2]);
      day = Number(nums[nums.length - 1]);
    }
  } else {
    // 7/1, 07(1), 06(26)
    month = Number(nums[0]);
    day = Number(nums[1]);
  }

  if (isValidMonthDay(month, day)) {
    return { ok: true, yyyy, month, day };
  }

  return { ok: false, yyyy: fallbackYear, month: 0, day: 0 };
}

function normalizeYear(yearValue: number, fallbackYear: number): number {
  if (yearValue >= 1000) {
    return yearValue;
  }

  if (yearValue >= 0 && yearValue <= 99) {
    return 2000 + yearValue;
  }

  return fallbackYear;
}

function isValidMonthDay(month: number, day: number): boolean {
  return month >= 1 && month <= 12 && day >= 1 && day <= 31;
}

function parseExcelSerialDate(
  serial: number
): { ok: boolean; yyyy: number; month: number; day: number } {
  if (serial < 60 || serial > 100000) {
    return { ok: false, yyyy: 0, month: 0, day: 0 };
  }

  // Excel serial date → JS date
  const utcMillis = Math.round((serial - 25569) * 86400 * 1000);
  const d = new Date(utcMillis);

  const yyyy = d.getUTCFullYear();
  const month = d.getUTCMonth() + 1;
  const day = d.getUTCDate();

  if (yyyy < 2000 || yyyy > 2100 || !isValidMonthDay(month, day)) {
    return { ok: false, yyyy: 0, month: 0, day: 0 };
  }

  return { ok: true, yyyy, month, day };
}

function makeSheetNameCandidates(
  input: string,
  sourceYyMm: string,
  sourceDateInfo: SourceDateInfo
): string[] {
  const raw = input.trim();
  const normalized = normalizeInputText(raw);

  const candidates: string[] = [];

  const defaultMonth = sourceYyMm.split(".")[1] || "06";
  const defaultMonthPad = defaultMonth.padStart(2, "0");
  const defaultMonthNum = String(Number(defaultMonth));

  // 월/일 날짜가 명확하면 그 날짜 기준 후보를 최우선 생성
  if (
    sourceDateInfo.hasExplicitMonthDay &&
    sourceDateInfo.day > 0 &&
    sourceDateInfo.month >= 1 &&
    sourceDateInfo.month <= 12
  ) {
    addDateCandidates(
      candidates,
      sourceDateInfo.monthPad,
      sourceDateInfo.monthNum,
      sourceDateInfo.dayNum,
      sourceDateInfo.dayPad
    );

    addUnique(candidates, raw);
    addUnique(candidates, normalized);

    return candidates;
  }

  // 숫자만 입력한 경우: 28 → 5시 기준 월로 긴급 06(28) 후보들 생성
  if (/^\d{1,2}$/.test(normalized)) {
    const dayNum = String(Number(normalized));
    const dayPad = normalized.padStart(2, "0");

    addDateCandidates(candidates, defaultMonthPad, defaultMonthNum, dayNum, dayPad);
    return candidates;
  }

  addUnique(candidates, raw);
  addUnique(candidates, normalized);

  const nums = normalized.match(/\d{1,2}/g);

  if (nums && nums.length > 0) {
    const day = nums[nums.length - 1];
    const dayNum = String(Number(day));
    const dayPad = day.padStart(2, "0");

    let month = defaultMonthPad;

    if (nums.length >= 2) {
      month = nums[nums.length - 2].padStart(2, "0");
    }

    const monthPad = month.padStart(2, "0");
    const monthNum = String(Number(month));

    addDateCandidates(candidates, monthPad, monthNum, dayNum, dayPad);
  }

  return candidates;
}

function addDateCandidates(
  candidates: string[],
  monthPad: string,
  monthNum: string,
  dayNum: string,
  dayPad: string
) {
  if (!dayNum || !dayPad) return;

  // 가장 가능성 높은 순서
  addUnique(candidates, `긴급 ${monthPad}(${dayNum})`);
  addUnique(candidates, `긴급 ${monthPad} (${dayNum})`);
  addUnique(candidates, `긴급${monthPad}(${dayNum})`);

  addUnique(candidates, `긴급 ${monthNum}(${dayNum})`);
  addUnique(candidates, `긴급 ${monthNum} (${dayNum})`);
  addUnique(candidates, `긴급${monthNum}(${dayNum})`);

  addUnique(candidates, `긴급 ${monthPad}(${dayPad})`);
  addUnique(candidates, `긴급 ${monthPad} (${dayPad})`);
  addUnique(candidates, `긴급${monthPad}(${dayPad})`);

  addUnique(candidates, `긴급 ${monthNum}(${dayPad})`);
  addUnique(candidates, `긴급 ${monthNum} (${dayPad})`);
  addUnique(candidates, `긴급${monthNum}(${dayPad})`);
}

function addUnique(arr: string[], value: string) {
  if (!value) return;

  if (!arr.includes(value)) {
    arr.push(value);
  }
}

function escapeSheetName(sheetName: string): string {
  return sheetName.replace(/'/g, "''");
}

function normalizeInputText(value: string): string {
  return String(value)
    .replace(/（/g, "(")
    .replace(/）/g, ")")
    .replace(/\u00A0/g, " ")
    .replace(/\u200B/g, "")
    .replace(/\u200C/g, "")
    .replace(/\u200D/g, "")
    .replace(/\s+/g, " ")
    .trim();
}
