// ======================================================
// 이름 매칭 보조
// ======================================================


type NameMaps = {
exactNameToRowOffset: Map<string, number>;
compactNameToRowOffset: Map<string, number>;
};


function buildNameMaps(baseNameTexts: string[][]): NameMaps {
const exactNameToRowOffset = new Map<string, number>();
const compactNameToRowOffset = new Map<string, number>();


for (let r = 0; r < baseNameTexts.length; r++) {
const name = cleanName(baseNameTexts[r][0]);
if (!name) continue;


if (!exactNameToRowOffset.has(name)) {
  exactNameToRowOffset.set(name, r);
}


const compactKey = normalizeNameKey(name);


if (compactKey && !compactNameToRowOffset.has(compactKey)) {
  compactNameToRowOffset.set(compactKey, r);
}
}


return {
exactNameToRowOffset,
compactNameToRowOffset
};
}


function resolveNameRowOffset(name: string, nameMaps: NameMaps): number | undefined {
const cleaned = cleanName(name);
if (!cleaned) return undefined;


const exactMatch = nameMaps.exactNameToRowOffset.get(cleaned);


if (exactMatch !== undefined) {
return exactMatch;
}


const compactKey = normalizeNameKey(cleaned);
return nameMaps.compactNameToRowOffset.get(compactKey);
}


function normalizeNameKey(value: string): string {
return String(value ?? "")
.replace(/\s+/g, "")
.trim()
.toUpperCase();
}


// ======================================================
// 공통 보조 함수
// ======================================================


function getWorksheetByName(
workbook: ExcelScript.Workbook,
sheetName: string
): ExcelScript.Worksheet | undefined {
const sheets = workbook.getWorksheets();


for (const sheet of sheets) {
if (sheet.getName() === sheetName) {
return sheet;
}
}


return undefined;
}


function hasAnyText(row: string[]): boolean {
for (const v of row) {
if (String(v ?? "").trim() !== "") {
return true;
}
}


return false;
}


function getExistingOutputRowCount(
sheet: ExcelScript.Worksheet,
startRow: number,
startCol: number,
colCount: number,
maxRows: number
): number {
const texts = sheet
.getRangeByIndexes(startRow - 1, startCol, maxRows, colCount)
.getTexts();


let lastOffset = -1;


for (let r = 0; r < texts.length; r++) {
if (hasAnyText(texts[r])) {
lastOffset = r;
}
}


return lastOffset + 1;
}


function isTargetFlag(value: string | number | boolean, text: string): boolean {
if (typeof value === "boolean") {
return value === true;
}


const raw = String(text || value || "")
.replace(/\s+/g, "")
.trim()
.toUpperCase();


if (!raw) return false;


return (
raw === "Y" ||
raw === "YES" ||
raw === "1" ||
raw === "TRUE" ||
raw === "O" ||
raw === "OK" ||
raw === "V" ||
raw === "대상" ||
raw === "체크"
);
}


function cleanName(value: string): string {
return String(value ?? "")
.replace(/\s+/g, " ")
.trim();
}


function extractWeekNumber(text: string): number | null {
const cleaned = String(text ?? "").trim();


const match = cleaned.match(/(\d{1,2})\s*주/);
if (match) {
return Number(match[1]);
}


const numOnly = cleaned.match(/^(\d{1,2})$/);
if (numOnly) {
return Number(numOnly[1]);
}


return null;
}


function parseExcelDate(
value: string | number | boolean,
text: string,
fallbackYear: number
): Date | null {
const raw = String(text ?? "")
.replace(/^'/, "")
.trim();


if (typeof value === "number" && value > 1000) {
const excelEpoch = new Date(1899, 11, 30);
const date = new Date(excelEpoch.getTime() + value * 24 * 60 * 60 * 1000);


return new Date(
  date.getFullYear(),
  date.getMonth(),
  date.getDate()
);
}


if (!raw) return null;


// 20260719처럼 구분자 없는 YYYYMMDD
let compactMatch = raw.match(/^(\d{4})(\d{2})(\d{2})$/);


if (compactMatch) {
const year = Number(compactMatch[1]);
const month = Number(compactMatch[2]);
const day = Number(compactMatch[3]);


if (year >= 1900 && year <= 2200 && month >= 1 && month <= 12 && day >= 1 && day <= 31) {
  return new Date(year, month - 1, day);
}
}


// 셀이 텍스트로 변환된 Excel 날짜 일련번호(예: 46222)도 처리
const serialText = raw.replace(/,/g, "");


if (/^\d{5}(?:\.\d+)?$/.test(serialText)) {
const serial = Number(serialText);


if (serial > 1000 && serial < 100000) {
  const excelEpoch = new Date(1899, 11, 30);
  const date = new Date(excelEpoch.getTime() + serial * 24 * 60 * 60 * 1000);


  return new Date(
    date.getFullYear(),
    date.getMonth(),
    date.getDate()
  );
}
}


let m = raw.match(/(\d{4})[-./년\s]+(\d{1,2})[-./월\s]+(\d{1,2})/);


if (m) {
return new Date(
Number(m[1]),
Number(m[2]) - 1,
Number(m[3])
);
}


m = raw.match(/(\d{1,2})[-./월\s]+(\d{1,2})/);


if (m) {
return new Date(
fallbackYear,
Number(m[1]) - 1,
Number(m[2])
);
}


// B열이 16, 16일, 16일(목)처럼 일자만 표시된 경우 현재 월로 인식
m = raw.match(/^(\d{1,2})\s*일?(?:\s*\([^)]*\))?$/);


if (m) {
const day = Number(m[1]);


if (day >= 1 && day <= 31) {
  const koreaToday = getKoreaToday();
  return new Date(fallbackYear, koreaToday.getMonth(), day);
}
}


return null;
}


function getKoreaToday(): Date {
const now = new Date();


const koreaText = now.toLocaleString("en-US", {
timeZone: "Asia/Seoul"
});


const koreaNow = new Date(koreaText);


return new Date(
koreaNow.getFullYear(),
koreaNow.getMonth(),
koreaNow.getDate()
);
}


function getWeekNumberBySundayJan1(date: Date): number {
const y = date.getFullYear();


const jan1 = new Date(y, 0, 1);
const jan1Day = jan1.getDay(); // 일요일=0, 토요일=6


// 1월 1일이 포함된 일~토를 1주차로 계산합니다.
const firstSunday = new Date(y, 0, 1 - jan1Day);
const target = new Date(y, date.getMonth(), date.getDate());


const diffDays = Math.floor(
(target.getTime() - firstSunday.getTime()) / (1000 * 60 * 60 * 24)
);


return Math.floor(diffDays / 7) + 1;
}


function parseTimeToHour(
value: string | number | boolean,
text: string
): number | null {
let raw = String(text ?? "")
.replace(/^'/, "")
.trim();


const compact = raw.replace(/\s+/g, "");


let m = compact.match(/^(\d{1,2})(\d{2})$/);


if (m && compact.length >= 3) {
const hour = Number(m[1]);
const minute = Number(m[2]);


if (hour >= 0 && hour <= 48 && minute >= 0 && minute < 60) {
  return round4(hour + minute / 60);
}
}


m = raw.match(/^(\d{1,3})\s*:\s*(\d{1,2})$/);


if (m) {
const hour = Number(m[1]);
const minute = Number(m[2]);


if (hour >= 0 && hour <= 48 && minute >= 0 && minute < 60) {
  return round4(hour + minute / 60);
}


return null;
}


m = raw.match(/^(\d{1,3})\s시\s(\d{1,2})?\s*분?$/);


if (m) {
const hour = Number(m[1]);
const minute = m[2] ? Number(m[2]) : 0;


if (hour >= 0 && hour <= 48 && minute >= 0 && minute < 60) {
  return round4(hour + minute / 60);
}


return null;
}


if (typeof value === "number") {
if (value > 1000) {
const fraction = value - Math.floor(value);
return round4(fraction * 24);
}


if (value >= 0 && value < 1) {
  return round4(value * 24);
}


if (value >= 0 && value <= 48) {
  return round4(value);
}
}


m = compact.match(/^(\d{1,2})(?:.(\d+))?$/);


if (m) {
const n = Number(compact);


if (n >= 0 && n <= 48) {
  return round4(n);
}
}


return null;
}


function splitTimeByHour(
startHour: number,
endHour: number,
maxSegments: number
): { start: number; end: number }[] | null {
const segments: { start: number; end: number }[] = [];


let current = round4(startHour);
let guard = 0;


while (current < endHour) {
guard++;


if (guard > maxSegments) {
  return null;
}


const nextHour = Math.floor(current) + 1;
const next = Math.min(nextHour, endHour);
const roundedNext = round4(next);


if (roundedNext <= current) {
  return null;
}


segments.push({
  start: round4(current),
  end: roundedNext
});


current = roundedNext;
}


return segments;
}


function formatHourToHHMM(hourValue: number): string {
const totalMinutes = Math.round(hourValue * 60);
const hour = Math.floor(totalMinutes / 60);
const minute = totalMinutes % 60;


return padLeft(hour, 2) + ":" + padLeft(minute, 2);
}


function formatDateToYYYYMMDD(date: Date): string {
return (
String(date.getFullYear()) +
"-" +
padLeft(date.getMonth() + 1, 2) +
"-" +
padLeft(date.getDate(), 2)
);
}


function classifyClaimOtReason(reason: string): string {
const raw = String(reason ?? "");
const compact = raw
.replace(/\s+/g, "")
.toUpperCase();


// 결점OT, 결점 OT, 팀장님요청, 팀장님 요청
if (
compact.includes("결점OT") ||
compact.includes("팀장님요청") ||
/OT(?:X|\d+(?:\.\d+)?)시간/.test(compact) ||
/(?:X|\d+(?:\.\d+)?)시간OT/.test(compact)
) {
return "투입률관리";
}


// $12345678 또는 12345678, 87654321처럼 독립된 8자리 숫자
if (/(^|\D)\d{8}(?!\d)/.test(raw)) {
return "응대미종결";
}


return "";
}


function padLeft(num: number, length: number): string {
let s = String(num);


while (s.length < length) {
s = "0" + s;
}


return s;
}


function round2(num: number): number {
return Math.round(num * 100) / 100;
}


function round4(num: number): number {
return Math.round(num * 10000) / 10000;
}


function round6(num: number): number {
return Math.round(num * 1000000) / 1000000;
}