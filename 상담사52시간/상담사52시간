// ======================================================
// 2) 각방OT(팀장용) → 청구OT 출력
// ======================================================


function runTeamLeadOtSheet(workbook: ExcelScript.Workbook, nameIssueNames: string[]) {
const sheet = getWorksheetByName(workbook, "각방OT(팀장용)");


if (!sheet) {
return;
}


let claimSheet = getWorksheetByName(workbook, "청구OT");


if (!claimSheet) {
claimSheet = workbook.addWorksheet("청구OT");
}


const START_ROW = 4;
const MAX_SCAN_ROWS = 10000;
const MAX_OUTPUT_CLEAR_SCAN_ROWS = 30000;
const MAX_SEGMENTS_PER_ROW = 48;


const COL_SRC_DATE = 1; // B
const COL_SRC_MANAGER = 7; // H
const SRC_COL_COUNT = COL_SRC_MANAGER - COL_SRC_DATE + 1; // B:H


const CLAIM_START_ROW = 9;
const CLAIM_COL_START = 8; // I
const CLAIM_COL_COUNT = 16; // I:X


const managerMap = buildManagerMapFromIndexSheet(workbook, MAX_SCAN_ROWS);


// 원본 B:H 정리: 담당팀장은 H열에 자동 반영하고 완전 중복만 제거
normalizeTeamLeadOtSourceRows(
sheet,
START_ROW,
MAX_SCAN_ROWS,
COL_SRC_DATE,
COL_SRC_MANAGER,
managerMap
);


// 기존 I열 대상 체크는 더 이상 사용하지 않으므로 제거
sheet
.getRangeByIndexes(START_ROW - 1, 8, MAX_SCAN_ROWS, 1)
.clear(ExcelScript.ClearApplyTo.all);


// 과거 각방OT 탭 J:Y 출력값은 제거하고 이후에는 청구OT에만 출력
const oldSameSheetOutputRows = getExistingOutputRowCount(
sheet,
START_ROW,
9,
16,
MAX_OUTPUT_CLEAR_SCAN_ROWS
);


if (oldSameSheetOutputRows > 0) {
sheet
.getRangeByIndexes(START_ROW - 1, 9, oldSameSheetOutputRows, 16)
.clear(ExcelScript.ClearApplyTo.contents);
}


const srcValuesFull = sheet
.getRangeByIndexes(
START_ROW - 1,
COL_SRC_DATE,
MAX_SCAN_ROWS,
SRC_COL_COUNT
)
.getValues();


const srcTextsFull = sheet
.getRangeByIndexes(
START_ROW - 1,
COL_SRC_DATE,
MAX_SCAN_ROWS,
SRC_COL_COUNT
)
.getTexts();


let lastSrcOffset = -1;


for (let r = 0; r < MAX_SCAN_ROWS; r++) {
// B:G 기준으로 원본 마지막 행 판단
if (hasAnyText(srcTextsFull[r].slice(0, 6))) {
lastSrcOffset = r;
}
}


const output: (string | number | boolean)[][] = [];
const koreaToday = getKoreaToday();
const recentStart = new Date(
koreaToday.getFullYear(),
koreaToday.getMonth(),
koreaToday.getDate() - 2
);
const recentStartTime = recentStart.getTime();
const todayTime = koreaToday.getTime();


if (lastSrcOffset >= 0) {
const rowCount = lastSrcOffset + 1;


for (let r = 0; r < rowCount; r++) {
  const rowTexts = srcTextsFull[r];
  const rowValues = srcValuesFull[r];


  if (!hasAnyText(rowTexts.slice(0, 6))) {
    continue;
  }


  const dateText = rowTexts[0];
  const dateValue = rowValues[0];
  const nameText = cleanName(rowTexts[1]);


  const startText = rowTexts[3];
  const startValue = rowValues[3];


  const endText = rowTexts[4];
  const endValue = rowValues[4];


  const reasonText = rowTexts[5];
  const managerText = cleanName(rowTexts[6]);
  const claimCategory = classifyClaimOtReason(reasonText);


  if (!dateText || !nameText || !startText || !endText) {
    continue;
  }


  const workDate = parseExcelDate(
    dateValue,
    dateText,
    koreaToday.getFullYear()
  );


  if (!workDate) {
    continue;
  }


  const workDateOnly = new Date(
    workDate.getFullYear(),
    workDate.getMonth(),
    workDate.getDate()
  );
  const workDateTime = workDateOnly.getTime();


  // 한국시간 오늘 포함 최근 3일만 출력: 오늘-2일, 오늘-1일, 오늘
  if (workDateTime < recentStartTime || workDateTime > todayTime) {
    continue;
  }


  const startHour = parseTimeToHour(startValue, startText);
  const endHourRaw = parseTimeToHour(endValue, endText);


  if (startHour === null || endHourRaw === null) {
    continue;
  }


  let endHour = endHourRaw;


  if (endHour < startHour) {
    endHour += 24;
  }


  const duration = round4(endHour - startHour);


  if (duration <= 0 || duration > MAX_SEGMENTS_PER_ROW) {
    continue;
  }


  const segments = splitTimeByHour(startHour, endHour, MAX_SEGMENTS_PER_ROW);


  if (segments === null) {
    continue;
  }


  for (const seg of segments) {
    output.push([
      managerText,                    // I - 담당팀장
      formatDateToYYYYMMDD(workDate), // J - 날짜
      "",                             // K
      nameText,                       // L - 이름
      "", "", "", "", "",           // M:Q
      formatHourToHHMM(seg.start),    // R - 시작
      formatHourToHHMM(seg.end),      // S - 종료
      "", "", "",                     // T:V
      claimCategory,                  // W - OT 분류
      reasonText                      // X - OT 사유
    ]);
  }
}
}


const previousOutputRows = getExistingOutputRowCount(
claimSheet,
CLAIM_START_ROW,
CLAIM_COL_START,
CLAIM_COL_COUNT,
MAX_OUTPUT_CLEAR_SCAN_ROWS
);


const clearRows = Math.max(previousOutputRows, output.length);


if (clearRows > 0) {
claimSheet
.getRangeByIndexes(
CLAIM_START_ROW - 1,
CLAIM_COL_START,
clearRows,
CLAIM_COL_COUNT
)
.clear(ExcelScript.ClearApplyTo.contents);
}


if (output.length > 0) {
const outRange = claimSheet.getRangeByIndexes(
CLAIM_START_ROW - 1,
CLAIM_COL_START,
output.length,
CLAIM_COL_COUNT
);


outRange.setNumberFormatLocal("@");
outRange.setValues(output);
}


}


// ======================================================
// 각방OT 원본 B:H 정리
// - 이름이나 날짜가 다르면 원본 행 유지
// - H열 담당팀장 자동 출력
// - I열 대상 체크는 사용하지 않음
// - 날짜 + 이름 + 시작 + 종료가 모두 같은 완전 중복만 제거
// ======================================================


function normalizeTeamLeadOtSourceRows(
sheet: ExcelScript.Worksheet,
startRow: number,
maxScanRows: number,
sourceStartCol: number,
sourceEndCol: number,
managerMap: Map<string, string>
) {
const colCount = sourceEndCol - sourceStartCol + 1;


const values = sheet
.getRangeByIndexes(startRow - 1, sourceStartCol, maxScanRows, colCount)
.getValues();


const texts = sheet
.getRangeByIndexes(startRow - 1, sourceStartCol, maxScanRows, colCount)
.getTexts();


let lastOffset = -1;


for (let r = 0; r < maxScanRows; r++) {
// B:G 기준으로 실제 원본 데이터 있는 행만 마지막 행으로 인정
if (hasAnyText(texts[r].slice(0, 6))) {
lastOffset = r;
}
}


if (lastOffset < 0) {
return;
}


const rowCount = lastOffset + 1;
const koreaToday = getKoreaToday();
const fallbackYear = koreaToday.getFullYear();


const seenExactRows = new Set<string>();
const normalizedRows: (string | number | boolean)[][] = [];


for (let r = 0; r < rowCount; r++) {
const rowTexts = texts[r];
const rowValues = values[r];


if (!hasAnyText(rowTexts.slice(0, 6))) {
  continue;
}


const dateText = rowTexts[0];
const dateValue = rowValues[0];


const idText = getCellTextForWrite(rowTexts[2], rowValues[2]);
const nameText = cleanName(rowTexts[1]);


const startText = rowTexts[3];
const startValue = rowValues[3];


const endText = rowTexts[4];
const endValue = rowValues[4];


const reasonText = getCellTextForWrite(rowTexts[5], rowValues[5]);
const managerText = resolveManagerTextForTeamLeadOt(nameText, rowTexts, rowValues, managerMap);


if (!dateText || !nameText || !startText || !endText) {
  normalizedRows.push([
    getCellTextForWrite(rowTexts[0], rowValues[0]),
    nameText,
    idText,
    getCellTextForWrite(rowTexts[3], rowValues[3]),
    getCellTextForWrite(rowTexts[4], rowValues[4]),
    reasonText,
    managerText
  ]);
  continue;
}


const startHour = parseTimeToHour(startValue, startText);
const endHourRaw = parseTimeToHour(endValue, endText);


if (startHour === null || endHourRaw === null) {
  normalizedRows.push([
    getCellTextForWrite(rowTexts[0], rowValues[0]),
    nameText,
    idText,
    getCellTextForWrite(rowTexts[3], rowValues[3]),
    getCellTextForWrite(rowTexts[4], rowValues[4]),
    reasonText,
    managerText
  ]);
  continue;
}


let endHour = endHourRaw;


if (endHour < startHour) {
  endHour += 24;
}


const duration = round4(endHour - startHour);


if (duration <= 0 || duration > 48) {
  normalizedRows.push([
    getCellTextForWrite(rowTexts[0], rowValues[0]),
    nameText,
    idText,
    getCellTextForWrite(rowTexts[3], rowValues[3]),
    getCellTextForWrite(rowTexts[4], rowValues[4]),
    reasonText,
    managerText
  ]);
  continue;
}


const dateKey = buildDateKey(dateValue, dateText, fallbackYear);
const nameKey = normalizeNameKey(nameText);
const normalizedStart = formatHourToHHMM(startHour);
const normalizedEnd = formatHourToHHMM(endHour);
const exactDuplicateKey = [
  dateKey,
  nameKey,
  normalizedStart,
  normalizedEnd
].join("|");


// 날짜, 이름, 시작 시간, 종료 시간이 전부 같을 때만 중복으로 제거한다.
// 날짜가 다르거나 시간이 일부만 겹치는 행은 그대로 유지한다.
if (seenExactRows.has(exactDuplicateKey)) {
  continue;
}


seenExactRows.add(exactDuplicateKey);


normalizedRows.push([
  dateText,
  nameText,
  idText,
  normalizedStart,
  normalizedEnd,
  reasonText,
  managerText
]);
}


const clearRange = sheet.getRangeByIndexes(
startRow - 1,
sourceStartCol,
rowCount,
colCount
);


clearRange.clear(ExcelScript.ClearApplyTo.contents);


if (normalizedRows.length > 0) {
const writeRange = sheet.getRangeByIndexes(
startRow - 1,
sourceStartCol,
normalizedRows.length,
colCount
);


writeRange.setNumberFormatLocal("@");
writeRange.setValues(normalizedRows);
}
}


function buildManagerMapFromIndexSheet(
workbook: ExcelScript.Workbook,
maxScanRows: number
): Map<string, string> {
const managerMap = new Map<string, string>();
const indexSheet = getWorksheetByName(workbook, "인덱스");


if (!indexSheet) {
return managerMap;
}


const COL_INDEX_NAME = 9; // J
const COL_INDEX_MANAGER = 10; // K


const texts = indexSheet
.getRangeByIndexes(0, COL_INDEX_NAME, maxScanRows, 2)
.getTexts();


for (let r = 0; r < texts.length; r++) {
const name = cleanName(texts[r][0]);
const manager = cleanName(texts[r][1]);


if (!name || !manager) {
  continue;
}


const key = normalizeNameKey(name);


if (key && !managerMap.has(key)) {
  managerMap.set(key, manager);
}
}


return managerMap;
}


function resolveManagerName(name: string, managerMap: Map<string, string>): string {
const key = normalizeNameKey(name);
const manager = managerMap.get(key);


return manager ? manager : "";
}


function resolveManagerTextForTeamLeadOt(
name: string,
rowTexts: string[],
rowValues: (string | number | boolean)[],
managerMap: Map<string, string>
): string | number | boolean {
const nameKey = normalizeNameKey(name);
const managerFromIndexSheet = managerMap.get(nameKey);


if (managerFromIndexSheet) {
return managerFromIndexSheet;
}


// H열이 예전 대상체크(Y 등)로 쓰이던 값이면 담당팀장으로 보존하지 않음
if (isTargetFlag(rowValues[6], rowTexts[6])) {
return "";
}


return getCellTextForWrite(rowTexts[6], rowValues[6]);
}


function buildDateKey(
value: string | number | boolean,
text: string,
fallbackYear: number
): string {
const date = parseExcelDate(value, text, fallbackYear);


if (!date) {
return String(text ?? "").replace(/\s+/g, "").trim();
}


return (
String(date.getFullYear()) +
"-" +
padLeft(date.getMonth() + 1, 2) +
"-" +
padLeft(date.getDate(), 2)
);
}


function getCellTextForWrite(
text: string,
value: string | number | boolean
): string | number | boolean {
const cleanedText = String(text ?? "").trim();


if (cleanedText !== "") {
return cleanedText;
}


if (typeof value === "boolean") {
return value;
}


if (typeof value === "number") {
return value;
}


return String(value ?? "");
}


function rowToTextValues(
rowTexts: string[],
rowValues: (string | number | boolean)[],
colCount: number
): (string | number | boolean)[] {
const row: (string | number | boolean)[] = [];


for (let c = 0; c < colCount; c++) {
row.push(getCellTextForWrite(rowTexts[c], rowValues[c]));
}


return row;
}


