/**
 * 월말팀시트 - Excel Office Script
 *
 * 리스트!B2:B에 적힌 이름마다 '베이스' 탭을 복제하고,
 * 복제한 탭의 이름을 해당 사람 이름으로 지정합니다.
 */

const LIST_SHEET_NAME = "리스트";
const BASE_SHEET_NAME = "베이스";
const LIST_FIRST_ROW_INDEX = 1; // Excel 2행, 0-based
const LIST_NAME_COLUMN_INDEX = 1; // B열, 0-based
const MAX_SHEET_NAME_LENGTH = 31;

function main(workbook: ExcelScript.Workbook): string {
  const listSheet = workbook.getWorksheet(LIST_SHEET_NAME);
  const baseSheet = workbook.getWorksheet(BASE_SHEET_NAME);

  if (!listSheet) {
    throw new Error(`시트 이름 확인: '${LIST_SHEET_NAME}' 탭이 없습니다.`);
  }
  if (!baseSheet) {
    throw new Error(`시트 이름 확인: '${BASE_SHEET_NAME}' 탭이 없습니다.`);
  }

  const requestedNames = readUniqueNames(listSheet);
  if (requestedNames.length === 0) {
    throw new Error(
      `'${LIST_SHEET_NAME}' 탭 B2 아래에 이름이 없습니다. 아무 탭도 만들지 않았습니다.`
    );
  }

  const createdNames: string[] = [];
  const existingNames: string[] = [];
  const invalidNames: string[] = [];

  for (let index = 0; index < requestedNames.length; index++) {
    const originalName = requestedNames[index];
    const sheetName = makeValidSheetName(originalName);

    if (!sheetName) {
      invalidNames.push(originalName);
      continue;
    }

    // 기존 탭은 사용자의 내용을 보호하기 위해 덮어쓰지 않습니다.
    if (workbook.getWorksheet(sheetName)) {
      existingNames.push(sheetName);
      continue;
    }

    const newSheet = baseSheet.copy(ExcelScript.WorksheetPositionType.end);
    newSheet.setName(sheetName);
    createdNames.push(sheetName);
  }

  const resultParts: string[] = [
    `생성 ${createdNames.length}개`,
    `기존 탭 건너뜀 ${existingNames.length}개`,
    `사용 불가 이름 ${invalidNames.length}개`,
  ];
  const result = `월말팀시트 완료: ${resultParts.join(" / ")}`;

  console.log(result);
  if (createdNames.length > 0) {
    console.log(`생성된 탭: ${createdNames.join(", ")}`);
  }
  if (existingNames.length > 0) {
    console.log(`이미 있던 탭: ${existingNames.join(", ")}`);
  }
  if (invalidNames.length > 0) {
    console.log(`사용할 수 없던 이름: ${invalidNames.join(", ")}`);
  }

  listSheet.activate();
  return result;
}

function readUniqueNames(sheet: ExcelScript.Worksheet): string[] {
  const usedRange = sheet.getUsedRange(true);
  if (!usedRange) return [];

  const lastRowExclusive = usedRange.getRowIndex() + usedRange.getRowCount();
  if (lastRowExclusive <= LIST_FIRST_ROW_INDEX) return [];

  const rowCount = lastRowExclusive - LIST_FIRST_ROW_INDEX;
  const texts = sheet
    .getRangeByIndexes(
      LIST_FIRST_ROW_INDEX,
      LIST_NAME_COLUMN_INDEX,
      rowCount,
      1
    )
    .getTexts();
  const unique: { [normalizedName: string]: boolean } = {};
  const names: string[] = [];

  for (let row = 0; row < texts.length; row++) {
    const displayName = cleanName(texts[row][0]);
    if (!displayName) continue;

    const normalizedName = displayName.toLocaleLowerCase();
    if (unique[normalizedName]) continue;

    unique[normalizedName] = true;
    names.push(displayName);
  }

  return names;
}

function cleanName(value: string): string {
  return String(value == null ? "" : value)
    .replace(/[\u200B-\u200D\uFEFF]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function makeValidSheetName(value: string): string {
  let name = cleanName(value)
    .replace(/[:\\/?*\[\]]/g, "-")
    .replace(/^'+|'+$/g, "")
    .trim();

  if (name.length > MAX_SHEET_NAME_LENGTH) {
    name = name.slice(0, MAX_SHEET_NAME_LENGTH).trim();
  }

  return name;
}

